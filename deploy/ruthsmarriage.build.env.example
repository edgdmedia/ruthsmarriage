# Build-time configuration for the Ruth's Marriage site.
#
# Install as /etc/ruthsmarriage.build.env:
#     sudo install -o root -g root -m 644 deploy/ruthsmarriage.build.env.example /etc/ruthsmarriage.build.env
#
# These are the variables the BUILD needs. They are not secrets, so the file
# can be world-readable; the secrets live in /etc/ruthsmarriage.env, which
# only root can read. The deploy script (scripts/deploy-vps.sh) sources this
# file before `pnpm build`.
#
# Why the build needs them: the database path, the session directory and the
# media adapter are baked into the bundle, EMDASH_SITE_URL decides whether
# Astro serves optimised images or the original files, and
# PUBLIC_TURNSTILE_SITE_KEY is inlined into the client bundle.

# The public origin. For a staging build use the staging host
# (https://vps.ruthsmarriage.com) and nothing else changes.
EMDASH_SITE_URL=https://vps.ruthsmarriage.com

# The SQLite file and the session store.
DATABASE_PATH=/home/ruthsmarriage/data/emdash.db
SESSION_DIR=/home/ruthsmarriage/data/sessions

# Media: the S3 adapter (R2 over its S3 API) is chosen when S3_BUCKET is
# set. The credentials are runtime secrets and are NOT here.
S3_BUCKET=ruthsmarriage-media
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto

# Turnstile widget: the public site key is inlined into the browser bundle
# at build time (the secret lives in /etc/ruthsmarriage.env).
PUBLIC_TURNSTILE_SITE_KEY=

# MEDIA_DIR is only used when the local storage driver falls back (no
# S3_BUCKET). On the VPS media is always in R2, so this is empty on purpose.
# MEDIA_DIR=
