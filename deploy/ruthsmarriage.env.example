# Runtime configuration for the Ruth's Marriage Node process.
#
# Install as /etc/ruthsmarriage.env:
#     sudo install -o root -g root -m 600 deploy/ruthsmarriage.env.example /etc/ruthsmarriage.env
#     sudo nano /etc/ruthsmarriage.env
#
# systemd reads this file as root and passes the variables to the process.
# Format: KEY=value, one per line, no `export`, no shell quoting. A value
# with a `#` or spaces is fine — systemd does not parse comments inside a
# value.

# --- The public origin -----------------------------------------------------
# For staging this is https://vps.ruthsmarriage.com. Also set at BUILD time
# (see /etc/ruthsmarriage.build.env): the image endpoint builds absolute
# URLs from it.
EMDASH_SITE_URL=https://vps.ruthsmarriage.com

# --- Paths ------------------------------------------------------------------
# The database lives on local disk, not on NFS: SQLite runs in WAL mode and
# WAL needs shared memory.
DATABASE_PATH=/home/ruthsmarriage/data/emdash.db
# Astro's session store (the admin's login). Outside the app directory, so a
# deploy does not log the newsroom out.
SESSION_DIR=/home/ruthsmarriage/data/sessions

# --- Where the site listens -------------------------------------------------
HOST=127.0.0.1
PORT=4322

# --- Secrets ----------------------------------------------------------------
# Encrypts EmDash's plugin settings and tokens; a different key makes the
# stored settings unreadable. Generate one with:  npx emdash secrets generate
EMDASH_ENCRYPTION_KEY=

# Resend, for invites, magic links and password recovery. The From domain is
# verified in Resend.
RESEND_API_KEY=

# Turnstile, for the Ask Coach form (verified server-side).
TURNSTILE_SECRET_KEY=

# The Ask Coach form saves its (draft) questions into EmDash through this
# token. A long-lived personal access token with content:write on the
# ask_coach_questions collection. Self-hosted: the service talks to itself
# through the loopback.
EMDASH_URL=http://127.0.0.1:4322
EMDASH_TOKEN=

# Do NOT set ASKCOACH_TO / ASKCOACH_FROM here: the built-in defaults
# (admin@ruthsmarriage.com) always apply. Confirm with the owner before the
# first real send.

# Cloudflare: the zone and a token with Zone > Cache Purge. The token is
# what lets a publish drop the affected pages from the edge cache.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
# Set to 0 to switch the purge plugin off (the site still works, the edge
# cache is just never purged).
CLOUDFLARE_PURGE_ENABLED=1

# --- Media (Cloudflare R2 over its S3 API) ----------------------------------
# The media stays in R2 (the owner's decision, D17): the stored storageKeys
# already live in the ruthsmarriage-media bucket and the URLs do not change.
#
# The owner creates the token in the Cloudflare dashboard:
# R2 > Manage R2 API Tokens > Create API token > Object Read & Write,
# scoped to the ruthsmarriage-media bucket.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=ruthsmarriage-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Optional: a public URL for the bucket, if one is set up.
# S3_PUBLIC_URL=
