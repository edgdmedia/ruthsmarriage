         "color": "rgb(46, 46, 46)",
         "width": "929px",
         "marginTop": "8px",
         "marginBottom": "16px",
         "text": "WHEN THE NO-SHOW/LATE CANCEL FEE IS WAIVED"
        },
        {
         "tag": "p",
         "box": [
          40,
          734,
          929,
          120
         ],
         "fontFamily": "Poppins",
