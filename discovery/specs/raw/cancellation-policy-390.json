         "lineHeight": "28.8px",
         "color": "rgb(46, 46, 46)",
         "width": "335px",
         "marginTop": "8px",
         "marginBottom": "16px",
         "text": "WHEN THE NO-SHOW/LATE CANCEL FEE IS WAIVED"
        },
        {
         "tag": "p",
         "box": [
