     "children": [
      {
       "id": "509c898",
       "type": "text-editor",
       "cls": "",
       "box": [
        143,
        537,
        1140,
        1177
       ],
       "gap": "20px",
       "width": "1140px",
       "maxWidth": "100%",
       "position": "relative",
       "parts": [
        {
         "tag": "p",
         "box": [
          143,
          537,
          1140,
          24
         ],
         "fontFamily": "Poppins",
         "fontSize": "16px",
         "fontWeight": "400",
         "lineHeight": "24px",
         "color": "rgb(46, 46, 46)",
         "width": "1140px",
         "marginBottom": "14.4px",
         "text": "Please scroll down to read our confidentiality and cancellation policy and check the “I agree” button to proceed."
        },
        {
         "tag": "strong",
         "box": [
          143,
          537,
          917,
          23
         ],
         "fontFamily": "Poppins",
         "fontSize": "16px",
         "fontWeight": "700",
         "lineHeight": "24px",
         "color": "rgb(46, 46, 46)",
         "display": "inline",
         "text": "Please scroll down to read our confidentiality and cancellation policy and check the “I agree” button to proceed."
        },
        {
         "tag": "p",
         "box": [
          143,
          575,
          1140,
          24
         ],
         "fontFamily": "Poppins",
         "fontSize": "16px",
         "fontWeight": "400",
         "lineHeight": "24px",
         "color": "rgb(46, 46, 46)",
         "width": "1140px",
         "marginBottom": "14.4px",
         "text": "1. INTRODUCTION"
        },
        {
         "tag": "strong",
         "box": [
          143,
          575,
          11,
          23
         ],
         "fontFamily": "Poppins",
         "fontSize": "16px",
         "fontWeight": "700",
         "lineHeight": "24px",
         "color": "rgb(46, 46, 46)",
         "display": "inline",
         "text": "1."
        },
        {
         "tag": "p",
         "box": [
          143,
          614,
          1140,
          48
         ],
         "fontFamily": "Poppins",
         "fontSize": "16px",
         "fontWeight": "400",
         "lineHeight": "24px",
         "color": "rgb(46, 46, 46)",
         "width": "1140px",
         "marginBottom": "14.4px",
         "text": "At Ruth’s Marriage, we are committed to providing a safe and confidential environment for our clients. This confidentiality policy outlines how we handle your personal information and the limits to confidentiality that may apply during the course of marriage counseling sessions."
        },
        {
         "tag": "h4",
         "box": [
          143,
          676,
          1140,
          29
         ],
         "fontFamily": "Poppins",
         "fontSize": "24px",
         "fontWeight": "500",
         "lineHeight": "28.8px",
         "color": "rgb(46, 46, 46)",
         "width": "1140px",
         "marginTop": "8px",
         "marginBottom": "16px",
         "text": "2. Confidentiality Assurance"
        },
        {
         "tag": "p",
         "box": [
          143,
          721,
          1140,
          48
         ],
         "fontFamily": "Poppins",
         "fontSize": "16px",
         "fontWeight": "400",
         "lineHeight": "24px",
         "color": "rgb(46, 46, 46)",
         "width": "1140px",
         "marginBottom": "14.4px",
         "text": "2.1 Client-Counselor Privilege: All information shared during marriage counseling sessions is confidential. This means that your counselor will not disclose any information without your explicit written consent, except as required by law or ethical standards (see section 3)."
        },
        {
         "tag": "p",
         "box": [
          143,
          783,
          1140,
          48
         ],
         "fontFamily": "Poppins",
         "fontSize": "16px",
         "fontWeight": "400",
         "lineHeight": "24px",
         "color": "rgb(46, 46, 46)",
         "width": "1140px",
         "marginBottom": "14.4px",
         "text": "2.3 Protection of Records: Client records, including session notes, assessments, and any other documentation, will be securely stored and only accessible to authorized personnel as outlined in section 4."
        },
        {
         "tag": "h4",
         "box": [
          143,
          846,
          1140,
          29
         ],
         "fontFamily": "Poppins",
         "fontSize": "24px",
         "fontWeight": "500",
         "lineHeight": "28.8px",
         "color": "rgb(46, 46, 46)",
         "width": "1140px",
         "marginTop": "8px",
         "marginBottom": "16px",
         "text": "3. Limits to Confidentiality"
        },
        {
         "tag": "p",
         "box": [
          143,
          890,
          1140,
          48
         ],
         "fontFamily": "Poppins",
         "fontSize": "16px",
         "fontWeight": "400",
         "lineHeight": "24px",
         "color": "rgb(46, 46, 46)",
         "width": "1140px",
         "marginBottom": "14.4px",
         "text": "3.1 Domestic Abuse or Physical Abuse: If there is a reasonable report of physical abuse, we are legally obligated to inform the victim to report this to the appropriate authorities."
        },
        {
         "tag": "p",
         "box": [
          143,
          953,
          1140,
          48
         ],
         "fontFamily": "Poppins",
         "fontSize": "16px",
         "fontWeight": "400",
         "lineHeight": "24px",
         "color": "rgb(46, 46, 46)",
         "width": "1140px",
         "marginBottom": "14.4px",
         "text": "3.2 Threats of Harm: If you pose a serious threat of harm to yourself or others, we may need to take steps to ensure safety, which may include disclosing relevant information to appropriate parties, such as law enforcement or medical professionals."
        },
        {
         "tag": "p",
         "box": [
          143,
          1015,
          1140,
          24
         ],
         "fontFamily": "Poppins",
         "fontSize": "16px",
         "fontWeight": "400",
         "lineHeight": "24px",
         "color": "rgb(46, 46, 46)",
         "width": "1140px",
         "marginBottom": "14.4px",
         "text": "3.3 Court Orders: If a court orders the release of your counseling records, we may be required to comply with such an order."
        },
        {
         "tag": "p",
         "box": [
          143,
          1054,
          1140,
          48
         ],
         "fontFamily": "Poppins",
         "fontSize": "16px",
         "fontWeight": "400",
         "lineHeight": "24px",
         "color": "rgb(46, 46, 46)",
         "width": "1140px",
         "marginBottom": "14.4px",
         "text": "3.4 Supervision and Consultation: Your counselor may consult with other mental health professionals for supervision and training purposes. In such cases, your identity will be kept confidential."
        },
        {
         "tag": "h4",
         "box": [
          143,
          1116,
          1140,
          29
         ],
         "fontFamily": "Poppins",
         "fontSize": "24px",
         "fontWeight": "500",
         "lineHeight": "28.8px",
         "color": "rgb(46, 46, 46)",
         "width": "1140px",
         "marginTop": "8px",
         "marginBottom": "16px",
         "text": "4. Access to Client Information"
        }
       ]
      }
     ]
    }
