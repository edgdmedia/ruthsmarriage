---
/* Carousel — replaces JetEngine slick sliders (README D8, _global.md → Carousel).
   Slides are `.swiper-slide` children of the slot; markup is server-rendered and
   vanilla Swiper (src/scripts/carousel-init.ts) adds behaviour on the client. */
import "swiper/css";
import "swiper/css/pagination";
import "swiper/css/navigation";

interface Props {
    variant?: "content" | "hero";
    autoplayMs?: number;
    slidesPerViewOverride?: number;
}
const { variant = "content", autoplayMs, slidesPerViewOverride } = Astro.props;
const delay = autoplayMs ?? (variant === "hero" ? 9000 : 5000);
const spv = slidesPerViewOverride ?? (variant === "hero" ? 1 : 3);
const cfg = JSON.stringify(
    variant === "hero" || slidesPerViewOverride
        ? { slidesPerView: spv, delay }
        : {
              slidesPerView: 3,
              breakpoints: {
                  0: { slidesPerView: 1 },
                  768: { slidesPerView: 2 },
                  1025: { slidesPerView: 3 },
              },
              delay,
          },
);
---

<div class="carousel" style="position:relative">
    <div
        class="swiper"
        data-swiper={cfg}
        style={`--spv:${spv};margin:0 -10px;overflow:hidden`}
    >
        <div class="swiper-wrapper">
            <slot />
        </div>
        {variant === "content" && (
            <div class="swiper-pagination"></div>
        )}
        {variant === "hero" && (
            <button
                class="swiper-button-prev"
                style="position:absolute;top:50%;margin-top:-25px;left:10px;z-index:10;background:none;border:none;padding:0;cursor:pointer;width:50px;height:50px;display:flex;align-items:center;justify-content:center"
                aria-label="Previous"
            >
                <svg
                    width="30"
                    height="30"
                    viewBox="0 0 180 180"
                    fill="#ffffff"
                    aria-hidden="true"
                >
                    <path d="M119 47.3166C119 48.185 118.668 48.9532 118.003 49.6212L78.8385 89L118.003 128.379C118.668 129.047 119 129.815 119 130.683C119 131.552 118.668 132.32 118.003 132.988L113.021 137.998C112.356 138.666 111.592 139 110.729 139C109.865 139 109.101 138.666 108.436 137.998L61.9966 91.3046C61.3322 90.6366 61 89.8684 61 89C61 88.1316 61.3322 87.3634 61.9966 86.6954L108.436 40.002C109.101 39.334 109.865 39 110.729 39C111.592 39 112.356 39.334 113.021 40.002L118.003 45.012C119 46.4482 119 47.3166Z" />
                </svg>
            </button>
        )}
        {variant === "hero" && (
            <button
                class="swiper-button-next"
                style="position:absolute;top:50%;margin-top:-25px;right:10px;z-index:10;background:none;border:none;padding:0;cursor:pointer;width:50px;height:50px;display:flex;align-items:center;justify-content:center"
                aria-label="Next"
            >
                <svg
                    width="30"
                    height="30"
                    viewBox="0 0 180 180"
                    fill="#ffffff"
                    aria-hidden="true"
                    style="transform:scaleX(-1)"
                >
                    <path d="M119 47.3166C119 48.185 118.668 48.9532 118.003 49.6212L78.8385 89L118.003 128.379C118.668 129.047 119 129.815 119 130.683C119 131.552 118.668 132.32 118.003 132.988L113.021 137.998C112.356 138.666 111.592 139 110.729 139C109.865 139 109.101 138.666 108.436 137.998L61.9966 91.3046C61.3322 90.6366 61 89.8684 61 89C61 88.1316 61.3322 87.3634 61.9966 86.6954L108.436 40.002C109.101 39.334 109.865 39 110.729 39C111.592 39 112.356 39.334 113.021 40.002L118.003 45.012C119 46.4482 119 47.3166Z" />
                </svg>
            </button>
        )}
    </div>
</div>
<script>
    import { initCarousels } from "../scripts/carousel-init";
    initCarousels();
</script>
