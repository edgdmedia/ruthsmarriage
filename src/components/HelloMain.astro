---
/* HelloMain — Hello Elementor's default template (`.site-main`), used by blog
   posts, archives, search, 404, Freebies and Privacy Policy.
   Spec: page-maps/default-pages.md ("Shared .site-main rules"). The typography
   is :global because post bodies and archive excerpts are injected HTML. */
interface Props {
	title: string;
}
const { title } = Astro.props;
---

<div class="site-main">
	<h1 class="site-main__title">{title}</h1>
	<slot />
</div>

<style>
	.site-main {
		max-width: 1140px;
		margin: 0 auto;
		font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
		font-size: 16px;
		line-height: 24px;
		color: #333333;
	}
	@media (max-width: 1140px) {
		.site-main {
			padding: 0 10px;
		}
	}
	.site-main :global(:is(h1, h2, h3, h4, h5, h6)) {
		font-family: Nunito, sans-serif;
		font-weight: 600;
		line-height: 1.2;
		color: #333333;
		margin: 8px 0 16px;
	}
	.site-main :global(h1) { font-size: 40px; }
	.site-main :global(h2) { font-size: 32px; }
	.site-main :global(h3) { font-size: 28px; }
	.site-main :global(h4) { font-size: 24px; }
	.site-main :global(h5) { font-size: 20px; }
	.site-main :global(h6) { font-size: 16px; }
	.site-main :global(p) {
		margin: 0 0 14.4px;
	}
	.site-main :global(a) {
		color: #cc3366;
	}
	.site-main :global(a:hover) {
		color: #333366;
	}
	.site-main :global(img) {
		max-width: 100%;
		height: auto;
	}
	.site-main :global(blockquote) {
		margin: 0 0 14.4px;
		padding: 0 0 0 16px;
		border-left: 4px solid currentColor;
	}
	.site-main :global(.has-text-align-center) {
		text-align: center;
	}
	.site-main :global(.has-medium-font-size) {
		font-size: 20px;
	}
	.site-main :global(.has-vivid-cyan-blue-color) {
		color: #0693e3;
		background: none;
	}
	.site-main :global(.wp-block-pullquote) {
		margin: 0 0 16px;
		padding: 48px 0;
		text-align: center;
		border-top: 4px solid currentColor;
		border-bottom: 4px solid currentColor;
	}
	.site-main :global(.wp-block-pullquote blockquote) {
		border: 0;
		padding: 0;
	}
</style>
