---
/* HeroSlider — homepage hero, portrait/overlay slide layouts (home.md §1).
   Static content per D15; vanilla Swiper init via src/scripts/carousel-init.ts. */
import "swiper/css";
import "swiper/css/navigation";

interface Slide {
	layout: "portrait" | "overlay";
	title: string;
	subtitle: string;
	buttonLabel: string;
	buttonUrl: string;
	image: string;
	mobileImage?: string;
}
const { slides = [] } = Astro.props as { slides?: Slide[] };
const cfg = JSON.stringify({ slidesPerView: 1, delay: 9000 });
---
<div class="heroslider" style="position:relative;min-height:100vh;padding:10px">
	<div class="swiper" data-swiper={cfg} style="--spv:1;margin:0 -10px;overflow:hidden">
		<div class="swiper-wrapper">
			{slides.map((s) => (
				<div class="swiper-slide">
					<div
						class={`hero-slide hero-slide--${s.layout}`}
						style={`background-image:url(${s.image})`}
					>
						{s.layout === "overlay" && <div class="hero-slide__overlay"></div>}
						{s.mobileImage && <div class="hero-slide__mobile-bg" style={`background-image:url(${s.mobileImage})`}></div>}
						<div class="hero-slide__inner">
							<div class="hero-slide__content">
								<h1 class="hero-slide__title">{s.title}</h1>
								<p class="hero-slide__subtitle">{s.subtitle}</p>
								<a class="hero-slide__button" href={s.buttonUrl}>
									<svg width="15" height="15" viewBox="0 0 512 512" fill="currentColor" style="margin-right:5px" aria-hidden="true">
										<path d="M256 8C119 8 8 119 8 256s111 248 248 248 248-111 248-248S393 8 256 8zm0 448c-110.5 0-200-89.5-200-200S145.5 56 256 56s200 89.5 200 200-89.5 200-200 200zm-32-316v116h-67c-10.7 0-16 12.9-8.5 20.5l99 99c4.7 4.7 12.3 4.7 17 0l99-99c7.6-7.6 2.2-20.5-8.5-20.5h-67V140c0-6.6-5.4-12-12-12h-40c-6.6 0-12 5.4-12 12z" />
									</svg>
									{s.buttonLabel}
								</a>
							</div>
						</div>
					</div>
				</div>
			))}
		</div>
		<button class="swiper-button-prev" aria-label="Previous">
			<svg width="30" height="30" viewBox="0 0 180 180" fill="#ffffff" aria-hidden="true"><path d="M119 47.3166C119 48.185 118.668 48.9532 118.003 49.6212L78.8385 89L118.003 128.379C118.668 129.047 119 129.815 119 130.683C119 131.552 118.668 132.32 118.003 132.988L113.021 137.998C112.356 138.666 111.592 139 110.729 139C109.865 139 109.101 138.666 108.436 137.998L61.9966 91.3046C61.3322 90.6366 61 89.8684 61 89C61 88.1316 61.3322 87.3634 61.9966 86.6954L108.436 40.002C109.101 39.334 109.865 39 110.729 39C111.592 39 112.356 39.334 113.021 40.002L118.003 45.012C119 46.4482 119 47.3166Z"/></svg>
		</button>
		<button class="swiper-button-next" aria-label="Next">
			<svg width="30" height="30" viewBox="0 0 180 180" fill="#ffffff" aria-hidden="true" style="transform:scaleX(-1)"><path d="M119 47.3166C119 48.185 118.668 48.9532 118.003 49.6212L78.8385 89L118.003 128.379C118.668 129.047 119 129.815 119 130.683C119 131.552 118.668 132.32 118.003 132.988L113.021 137.998C112.356 138.666 111.592 139 110.729 139C109.865 139 109.101 138.666 108.436 137.998L61.9966 91.3046C61.3322 90.6366 61 89.8684 61 89C61 88.1316 61.3322 87.3634 61.9966 86.6954L108.436 40.002C109.101 39.334 109.865 39 110.729 39C111.592 39 112.356 39.334 113.021 40.002L118.003 45.012C119 46.4482 119 47.3166Z"/></svg>
		</button>
	</div>
</div>
<script>
	import { initCarousels } from "../scripts/carousel-init";
	initCarousels();
</script>

<style>
	.hero-slide {
		position: relative;
		min-height: 95vh;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		padding: 50px 50px 100px 80px;
		background-size: 130% auto;
		background-position: center left;
		background-repeat: no-repeat;
	}
	.hero-slide--overlay {
		min-height: 90vh;
		justify-content: center;
		padding: 50px;
		background-size: cover;
		background-position: center right;
	}
	.hero-slide__overlay {
		position: absolute;
		inset: 0;
		background: #5a0f36;
		opacity: 0.57;
	}
	.hero-slide__inner {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: 1440px;
		margin: 0 auto;
		display: flex;
	}
	.hero-slide__mobile-bg {
		display: none;
		position: absolute;
		inset: 0;
		background-size: cover;
		background-position: top center;
		background-repeat: no-repeat;
	}
	.hero-slide__content {
		position: relative;
		z-index: 1;
		width: 76%;
		padding: 10px;
		display: flex;
		flex-direction: column;
		gap: 30px;
	}
	.hero-slide--overlay .hero-slide__content {
		width: 70%;
		gap: 20px;
	}
	.hero-slide__title {
		font-family: Nunito, sans-serif;
		font-size: 99px;
		line-height: 99px;
		font-weight: 800;
		color: #ffffff;
		text-shadow: 4px 0 22px rgba(0, 0, 0, 0.3);
		margin: 0;
	}
	.hero-slide--overlay .hero-slide__title {
		font-size: 70px;
		line-height: 70px;
	}
	.hero-slide__subtitle {
		font-family: Poppins, sans-serif;
		font-size: 24px;
		line-height: 24px;
		font-weight: 400;
		color: #ffffff;
		margin: 0;
	}
	.hero-slide__button {
		align-self: flex-start;
		color: #bf1e72;
		background-color: #ffffff;
		border-radius: 20px;
		padding: 12px 24px;
		font-family: Nunito, sans-serif;
		font-size: 15px;
		line-height: 15px;
		font-weight: 500;
		text-decoration: none;
		display: inline-flex;
		align-items: center;
	}
	.hero-slide--overlay .hero-slide__button {
		padding: 15px 30px;
		font-size: 16px;
		line-height: 16px;
		font-weight: 600;
	}
	@media (max-width: 1024px) {
		.hero-slide__content { width: 88%; }
		.hero-slide__title { font-size: 72px; line-height: 72px; }
		.hero-slide__subtitle { font-size: 20px; line-height: 20px; }
	}
	@media (max-width: 767px) {
		.hero-slide, .hero-slide--overlay { padding: 30px; }
		.hero-slide__mobile-bg { display: block; }
		.hero-slide__content { width: 100%; }
		.hero-slide__title { font-size: 45px; line-height: 45px; }
		.hero-slide--overlay .hero-slide__title { font-size: 44px; line-height: 44px; }
		.hero-slide__subtitle { font-size: 16px; line-height: 16px; }
	}
</style>
