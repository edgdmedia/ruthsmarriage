---
// Renders page content in either of two shapes:
//
//   - PortableText (block/span) — used by services, resources and posts
//   - PageContent (rich PageBlock[]) — produced by scripts/reference/extract-page-content.mjs
//     for the captured WordPress pages
//
// Legacy PortableText blocks keep their block/span shape; rich blocks carry a `type`
// field and are rendered below. Both can be mixed on one page.
import type { PageBlock, PortableTextBlock } from "../data/types";
import type { PortableText } from "../data/types";

interface Props {
	value?: PageContent | PortableText | null;
}

type PageContent = PageBlock[];

const { value } = Astro.props;
const blocks: (PageBlock | PortableTextBlock)[] = value ?? [];

// Inline SVG markup for the FontAwesome icon names used by the extracted "Our Values"
// and contact icon boxes. Kept inline so nothing needs a client-side React island.
const iconSvg = (name: string) => {
	switch (name) {
		case "far-heart":
			return '<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41 0.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"></path></svg>';
		case "far-smile":
			return '<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="currentColor"><circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="M9.5 9.5c0-.83.67-1.5 1.5-1.5s1.5.67 1.5 1.5-.67 1.5-1.5 1.5-1.5-.67-1.5-1.5zM15 9.5c0 .83-.67 1.5-1.5 1.5s-1.5-.67-1.5-1.5.67-1.5 1.5-1.5 1.5.67 1.5 1.5zM12 16c-2.2 0-4.2-1.2-5.3-3 1-1.8 3-2.9 5.3-2.9s4.3 1.1 5.3 3c-1.1 1.8-3.1 3-5.3 3z"></path></svg>';
		case "fas-check":
			return '<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="currentColor"><path d="M16.7 7.3l-8 8.7-3-3.2-1.3 1.2 4.3 4.5 7.8-8.7z"></path></svg>';
		case "fas-users":
			return '<svg viewBox="0 0 640 512" xmlns="http://www.w3.org/2000/svg" fill="currentColor"><path d="M96 224c35.3 0 64-28.7 64-64s-28.7-64-64-64-64 28.7-64 64 28.7 64 64 64zm448 0c35.3 0 64-28.7 64-64s-28.7-64-64-64-64 28.7-64 64 28.7 64 64 64zm32 32h-64c-17.6 0-33.5 7.1-45.1 18.6 40.3 22.1 68.9 62 75.1 109.4h66c17.7 0 32-14.3 32-32v-32c0-35.3-28.7-64-64-64zm-256 0c61.9 0 112-50.1 112-112S381.9 32 320 32 208 82.1 208 144s50.1 112 112 112zm76.8 32h-8.3c-20.8 10-43.9 16-68.5 16s-47.6-6-68.5-16h-8.3C179.6 288 128 339.6 128 403.2V432c0 26.5 21.5 48 48 48h288c26.5 0 48-21.5 48-48v-28.8c0-63.6-51.6-115.2-115.2-115.2zm-223.7-13.4C161.5 263.1 145.6 256 128 256H64c-35.3 0-64 28.7-64 64v32c0 17.7 14.3 32 32 32h65.9c6.3-47.4 34.9-87.3 75.2-109.4z"></path></svg>';
		case "far-envelope":
			return '<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="currentColor"><path d="M20 4H4c-1.1 0-1.9 0.9-1.9 2L2 18c0 1.1 0.9 2 2 2h16c1.1 0 2-0.9 2-2V6c0-1.1-0.9-2-2-2zm0 4L12 13l-8-5h8zm0-5L12 9l-8-5h8z"></path></svg>';
		default:
			return "";
	}
};

---
{blocks.map((block) => {
	// Legacy PortableText block: { _type: "block", style, children: [{ _type: "span", text }] }
	if ((block as any)._type === "block") {
		const text = ((block as any).children ?? []).map((c: any) => c.text).join("");
		switch ((block as any).style) {
			case "h1": return <h1 set:html={text} />;
			case "h2": return <h2 set:html={text} />;
			case "h3": return <h3 set:html={text} />;
			case "h4": return <h4 set:html={text} />;
			case "blockquote": return <blockquote set:html={text} />;
			default: return <p set:html={text} />;
		}
	}

	const b = block as PageBlock;
	switch (b.type) {
		case "heading": {
			const render = (level: number) => {
				switch (level) {
					case 1: return <h1 set:html={b.html ?? b.text} />;
					case 2: return <h2 set:html={b.html ?? b.text} />;
					case 3: return <h3 set:html={b.html ?? b.text} />;
					case 4: return <h4 set:html={b.html ?? b.text} />;
					case 5: return <h5 set:html={b.html ?? b.text} />;
					case 6: return <h6 set:html={b.html ?? b.text} />;
					default: return <h2 set:html={b.html ?? b.text} />;
				}
			};
			return render(b.level);
		}
		case "paragraph":
			return <p class={b.dropCap ? "drop-cap" : undefined} set:html={b.html} />;
		case "image":
			return b.src ? <img src={b.src} alt={b.alt} loading="lazy" /> : null;
		case "button": {
			return (
				<a
					href={b.href}
					class="button btn btn--pink"
					style={{
						color: "#ffffff",
						backgroundColor: "#ED0D82",
						borderRadius: "20px",
						padding: "12px 24px",
						fontFamily: "'Nunito',sans-serif",
						fontSize: "15px",
						lineHeight: "15px",
						fontWeight: "500",
						textDecoration: "none",
						display: "inline-block",
					}}
				>
					{b.label}
				</a>
			);
		}
		case "divider":
			return <div class="page-divider" />;
		case "iconBox":
			return (
				<div class="icon-box">
					{b.icon ? (
						<div class="icon-box__icon" set:html={iconSvg(b.icon)} />
					) : null}
					{b.title ? <h3 class="icon-box__title">{b.title}</h3> : null}
					{b.text ? <p class="icon-box__text" set:html={b.text} /> : null}
				</div>
			);
		case "icon":
			return <div class="page-icon" set:html={iconSvg(b.icon)} />;
		case "video":
			return b.src ? <iframe src={b.src} title={b.title ?? ""} loading="lazy" /> : null;
		case "html":
			return <div set:html={b.html} />;
		case "listing":
			// Query-driven listings are rendered by the page template, not here.
			return null;
		case "hero":
			// The hero is pulled out into page fields (hero_title / hero_image).
			return null;
		default:
			return null;
	}
})}
