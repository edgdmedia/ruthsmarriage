---
// Renders PortableText content (block/span shape) used by services, resources and posts.
import type { PortableText, PortableTextBlock } from "../data/types";

interface Props {
	value?: PortableText | null;
}

const { value } = Astro.props;
const blocks: PortableTextBlock[] = value ?? [];

---
{blocks.map((block) => {
	// PortableText block: { _type: "block", style, children: [{ _type: "span", text }] }
	if (block._type === "block") {
		const text = (block.children ?? []).map((c: any) => c.text).join("");
		switch (block.style) {
			case "h1": return <h1 set:html={text} />;
			case "h2": return <h2 set:html={text} />;
			case "h3": return <h3 set:html={text} />;
			case "h4": return <h4 set:html={text} />;
			case "blockquote": return <blockquote set:html={text} />;
			default: return <p set:html={text} />;
		}
	}
	return null;
})}
