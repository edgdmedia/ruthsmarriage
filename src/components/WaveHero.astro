---
/* WaveHero — the site's page header (styles: components.css "Page header").
   Pass `image` for a photo header; without it the band shows the pink circles
   pattern. `overlap` adds bottom room for a cover that straddles the wave.
   PageHero.tsx renders the same markup for the React-era pages. */
interface Props {
	image?: string;
	overlap?: boolean;
}
const { image, overlap = false } = Astro.props;
---

<header
	class:list={["wave-hero", image ? "wave-hero--photo" : "wave-hero--pattern", { "wave-hero--overlap": overlap }]}
	style={image ? `--hero-bg: url("${image}")` : undefined}
>
	<div class="wave-hero__inner"><slot /></div>
	<img class="wave-hero__waves" src="/assets/waves.svg" alt="" />
</header>
