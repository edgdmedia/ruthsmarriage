---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint, getEmDashCollection } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { setCacheHint } from "../lib/cache";
import { Header } from "../components/Header";
import { Footer } from "../components/Footer";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/components.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
}

const { title, pageTitle, description, image, canonical, content } = Astro.props;

const settingsResult = await getSiteSettingsWithCacheHint();
const menuResult = await getMenuWithCacheHint("primary");
setCacheHint(Astro.cache, settingsResult.cacheHint);
setCacheHint(Astro.cache, menuResult.cacheHint);

const marqueeResult = await getEmDashCollection("marquee_items", {
	limit: 100,
	orderBy: { order: "asc" },
});
setCacheHint(Astro.cache, marqueeResult.cacheHint);

const { data: settings } = settingsResult;
const { data: menu } = menuResult;
const marqueeItems = marqueeResult.entries?.map((e) => ({
	text: e.data.text,
	link: e.data.link,
})) || [];

const siteTitle = settings?.title ?? "Ruth's Marriage";
const fullTitle = pageTitle ?? title;
const pageDescription = description ?? settings?.tagline ?? null;

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		{pageDescription && <meta name="description" content={pageDescription} />}
		{canonical && <link rel="canonical" href={canonical} />}
		{image && <meta property="og:image" content={image} />}
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />

		<Header menu={menu as any} logoSrc={settings?.logo?.url} marqueeItems={marqueeItems} />
		<main>
			<slot />
		</main>
		<Footer menus={menu ? { primary: menu as any } : undefined} settings={settings as any} />

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
