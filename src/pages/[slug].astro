---
import Base from "../layouts/Base.astro";
import { settings } from "../data";
import { getSeoMeta } from "../lib/seo";

const slug = Astro.params.slug ?? "";

const seo = getSeoMeta({
	title: `Page not found: ${slug}`,
	description: settings.tagline || null,
	siteTitle: settings.title,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});
---

<Base title={seo.title} pageTitle={seo.ogTitle} description={seo.description} canonical={seo.canonical} image={seo.ogImage}>
	<h1>Page not found</h1>
	<p>The page you're looking for doesn't exist.</p>
	<a href="/">Go home</a>
</Base>
