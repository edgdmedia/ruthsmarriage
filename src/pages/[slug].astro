---
// Single-segment URLs: blog posts live at /<slug>/ (as on WordPress); anything
// else is a 404. The post template is posts/[slug].astro.
import { getPost } from "../data";

const slug = Astro.params.slug ?? "";
const post = await getPost(slug);
return Astro.rewrite(post ? `/posts/${slug}/` : "/404");
---
