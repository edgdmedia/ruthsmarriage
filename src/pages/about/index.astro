---
import Base from "../../layouts/Base.astro";
import { PageHero } from "../../components/PageHero";
import { settings } from "../../data";
import { getSeoMeta } from "../../lib/seo";

const seo = getSeoMeta({
	title: "About Us",
	description: settings.tagline || null,
	image: "/assets/media/2025/06/0f916965-7f23-496.jpg",
	siteTitle: settings.title,
	siteUrl: "https://www.ruthsmarriage.com",
	path: "/about",
});
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
>
	<PageHero variant="photo" title="About Us" image="/assets/media/2025/06/0f916965-7f23-496.jpg" />

	<section class="story-section">
		<div class="story-inner">
			<div class="story-col story-text">
				<p class="story-para drop-cap">
					Ruth’s Marriage is a marriage counseling and coaching company focused on helping couples enjoy their marriage God’s way.
				</p>
				<p class="story-para">
					We believe that God’s purpose for marriage is good and also to make us better people, therefore most marriages can thrive with the right knowledge and support.
				</p>
				<p class="story-para">
					We also understand that the success of a marriage is equally dependent on who we marry, so we do not only focus on the married; we coach and guide singles on how to date purposefully and make wise marital decisions.
				</p>
				<p class="story-para">
					Our mission is to spread the gospel of a happy and thriving marriage, which eventually helps everyone to have a better society as the family is the smallest unit in a society.
				</p>
				<p class="story-para">
					At Ruth’s Marriage, we provide various specialized marriage therapy, couples counseling, premarital counseling, and relationship clarity services to individuals, singles, and couples. We also have tailor-made resources that help couples and individuals “do the work” without having to sit in front of a counselor.
				</p>
				<p class="story-para">
					Ruth’s Marriage is located in Lagos, Nigeria, and operates virtually, serving couples and singles from all over the world.
				</p>
			</div>
			<div
				class="story-col story-photo"
				style="background-image:url(/assets/media/2025/06/about-ruths-marriage.webp)"
			/>
		</div>
	</section>

	<section class="values-section">
		<div class="values-inner">
			<h2 class="values-heading">Our Values</h2>
			<div class="values-divider" />
			<div class="values-row">
				<div class="values-box" style="flex-basis: 212px">
					<div class="values-icon">
						<svg
							aria-hidden="true"
							viewBox="0 0 24 24"
							xmlns="http://www.w3.org/2000/svg"
							fill="currentColor"
						>
							<path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41 0.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
						</svg>
					</div>
					<h3 class="values-title">Love</h3>
					<p class="values-text">We love and relate with empathy towards all people.</p>
				</div>
				<div class="values-box" style="flex-basis: 265px">
					<div class="values-icon">
						<svg
							aria-hidden="true"
							viewBox="0 0 24 24"
							xmlns="http://www.w3.org/2000/svg"
							fill="currentColor"
						>
							<circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2" />
							<path d="M9.5 9.5c0-.83.67-1.5 1.5-1.5s1.5.67 1.5 1.5-.67 1.5-1.5 1.5-1.5-.67-1.5-1.5zM15 9.5c0 .83-.67 1.5-1.5 1.5s-1.5-.67 1.5-1.5.67-1.5 1.5-1.5 1.5 .67 1.5 1.5zM12 16c-2.2 0-4.2-1.2-5.3-3 1-1.8 3-2.9 5.3-2.9s4.3 1.1 5.3 3c-1.1 1.8-3.1 3-5.3 3z" />
						</svg>
					</div>
					<h3 class="values-title">Client Satisfaction</h3>
					<p class="values-text">
						Our services are client-focused and tailored to meet individual needs and our employees are trained to meet and exceed our client expectations.
					</p>
				</div>
				<div class="values-box" style="flex-basis: 265px">
					<div class="values-icon">
						<svg
							aria-hidden="true"
							viewBox="0 0 24 24"
							xmlns="http://www.w3.org/2000/svg"
							fill="currentColor"
						>
							<path d="M16.7 7.3l-8 8.7-3-3.2-1.3 1.2 4.3 4.5 7.8-8.7z" />
						</svg>
					</div>
					<h3 class="values-title">Professionalism</h3>
					<p class="values-text">
						Our employees carry themselves professionally, convey a good attitude, and communicate with our clients and their coworkers in a professional manner.
					</p>
				</div>
				<div class="values-box" style="flex-basis: 318px">
					<div class="values-icon">
						<svg
							aria-hidden="true"
							viewBox="0 0 640 512"
							xmlns="http://www.w3.org/2000/svg"
							fill="currentColor"
						>
							<path d="M96 224c35.3 0 64-28.7 64-64s-28.7-64-64-64-64 28.7-64 64 28.7 64 64 64zm448 0c35.3 0 64-28.7 64-64s-28.7-64-64-64-64 28.7-64 64 28.7 64 64 64zm32 32h-64c-17.6 0-33.5 7.1-45.1 18.6 40.3 22.1 68.9 62 75.1 109.4h66c17.7 0 32-14.3 32-32v-32c0-35.3-28.7-64-64-64zm-256 0c61.9 0 112-50.1 112-112S381.9 32 320 32 208 82.1 208 144s50.1 112 112 112zm76.8 32h-8.3c-20.8 10-43.9 16-68.5 16s-47.6-6-68.5-16h-8.3C179.6 288 128 339.6 128 403.2V432c0 26.5 21.5 48 48 48h288c26.5 0 48-21.5 48-48v-28.8c0-63.6-51.6-115.2-115.2-115.2zm-223.7-13.4C161.5 263.1 145.6 256 128 256H64c-35.3 0-64 28.7-64 64v32c0 17.7 14.3 32 32 32h65.9c6.3-47.4 34.9-87.3 75.2-109.4z" />
						</svg>
					</div>
					<h3 class="values-title">People-centric</h3>
					<p class="values-text">
						We take client feedback into consideration when implementing changes or making decisions. Whether as a client or employee, we strive to ensure a secure and safe process from onboarding to offboarding.
					</p>
				</div>
			</div>
		</div>
	</section>
</Base>

<style>
	.story-section {
		padding: 30px;
		box-sizing: border-box;
	}
	.story-inner {
		max-width: 1140px;
		margin: 0 auto;
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 20px;
		box-sizing: border-box;
	}
	.story-col {
		flex: 0 0 560px;
		width: 560px;
		padding: 10px;
		box-sizing: border-box;
	}
	.story-para {
		font-family: Poppins, sans-serif;
		font-size: 16px;
		line-height: 24px;
		font-weight: 400;
		color: #2e2e2e;
		margin: 0 0 0.9em;
		text-align: left;
	}
	.story-para.drop-cap::first-letter {
		float: left;
		font-family: Poppins, sans-serif;
		font-size: 50px;
		line-height: 50px;
		font-weight: 400;
		color: #bf1e72;
		margin: 0 10px 0 0;
		width: 36px;
		height: 50px;
	}
	.story-photo {
		height: 586px;
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
	}
	.values-section {
		background: rgba(233, 27, 130, 0.07);
		padding: 0 50px;
		box-sizing: border-box;
	}
	.values-inner {
		max-width: 1140px;
		margin: 0 auto;
		padding-top: 50px;
		padding-bottom: 50px;
		box-sizing: border-box;
	}
	.values-heading {
		font-family: Nunito, sans-serif;
		font-size: 32px;
		line-height: 32px;
		font-weight: 600;
		color: #bf1e72;
		text-align: center;
		margin: 0 auto;
		width: fit-content;
	}
	.values-divider {
		width: 59px;
		height: 2px;
		background: #000000;
		margin: 12px auto 50px;
	}
	.values-row {
		display: flex;
		gap: 20px;
		padding: 10px;
		box-sizing: border-box;
	}
	.values-box {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		padding: 0 10px;
		box-sizing: border-box;
	}
	.values-icon {
		width: 60px;
		height: 60px;
		border: 2px solid #bf1e72;
		border-radius: 50%;
		padding: 14px;
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 0 auto;
		box-sizing: border-box;
	}
	.values-icon svg {
		width: 28px;
		height: 28px;
		fill: #bf1e72;
		display: block;
	}
	.values-title {
		font-family: Poppins, sans-serif;
		font-size: 22px;
		line-height: 26.4px;
		font-weight: 600;
		color: #252627;
		text-align: center;
		margin: 23px 0 16px;
	}
	.values-text {
		font-family: Poppins, sans-serif;
		font-size: 16px;
		line-height: 24px;
		font-weight: 400;
		color: #000000;
		text-align: center;
		margin: 0;
	}
	@media (max-width: 1024px) {
		.story-section {
			padding: 30px 20px;
		}
		.story-inner {
			flex-direction: column;
			align-items: stretch;
		}
		.story-col {
			flex: none;
			width: 100%;
		}
		.story-photo {
			height: 450px;
			min-height: 450px;
			background-position: 0 -129px;
		}
		.values-section {
			padding: 0 20px;
		}
		.values-row {
			display: grid;
			grid-template-columns: repeat(2, 1fr);
		}
		.values-box {
			flex: none;
		}
	}
	@media (max-width: 767px) {
		.story-photo {
			background-position: center;
		}
		.values-row {
			grid-template-columns: 1fr;
			justify-items: center;
		}
		.values-box {
			width: 275px;
			max-width: 275px;
			padding: 0 10px;
		}
	}
</style>
