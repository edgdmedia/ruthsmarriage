---
import Base from "../../layouts/Base.astro";
import { PageHero } from "../../components/PageHero";
import { IconCheck } from "../../components/icons/check";
import { IconHeart } from "../../components/icons/heart";
import { IconSmile } from "../../components/icons/smile";
import { IconUsers } from "../../components/icons/users";
import { settings } from "../../data";
import { getSeoMeta } from "../../lib/seo";

const seo = getSeoMeta({
	title: "About Us",
	description: settings.tagline || null,
	image: "/assets/media/2025/06/0f916965-7f23-496.jpg",
	siteTitle: settings.title,
	siteUrl: "https://www.ruthsmarriage.com",
	path: "/about",
});
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
>
	<PageHero variant="photo" title="About Us" image="/assets/media/2025/06/0f916965-7f23-496.jpg" />

	<section class="story-section">
		<div class="story-inner">
			<div class="story-col story-text">
				<p class="story-para drop-cap">
					Ruth’s Marriage is a marriage counseling and coaching company focused on helping couples enjoy their marriage God’s way.
				</p>
				<p class="story-para">
					We believe that God’s purpose for marriage is good and also to make us better people, therefore most marriages can thrive with the right knowledge and support.
				</p>
				<p class="story-para">
					We also understand that the success of a marriage is equally dependent on who we marry, so we do not only focus on the married; we coach and guide singles on how to date purposefully and make wise marital decisions.
				</p>
				<p class="story-para">
					Our mission is to spread the gospel of a happy and thriving marriage, which eventually helps everyone to have a better society as the family is the smallest unit in a society.
				</p>
				<p class="story-para">
					At Ruth’s Marriage, we provide various specialized marriage therapy, couples counseling, premarital counseling, and relationship clarity services to individuals, singles, and couples. We also have tailor-made resources that help couples and individuals “do the work” without having to sit in front of a counselor.
				</p>
				<p class="story-para">
					Ruth’s Marriage is located in Lagos, Nigeria, and operates virtually, serving couples and singles from all over the world.
				</p>
			</div>
			<div
				class="story-col story-photo"
				style="background-image:url(/assets/media/2025/06/about-ruths-marriage.webp)"
			/>
		</div>
	</section>

	<section class="values-section">
		<div class="values-inner">
			<h2 class="values-heading">Our Values</h2>
			<div class="values-divider" />
			<div class="values-row">
				<div class="values-box">
					<div class="values-icon"><IconHeart /></div>
					<h3 class="values-title">Love</h3>
					<p class="values-text">We love and relate with empathy towards all people.</p>
				</div>
				<div class="values-box">
					<div class="values-icon"><IconSmile /></div>
					<h3 class="values-title">Client Satisfaction</h3>
					<p class="values-text">
						Our services are client-focused and tailored to meet individual needs and our employees are trained to meet and exceed our client expectations.
					</p>
				</div>
				<div class="values-box">
					<div class="values-icon"><IconCheck /></div>
					<h3 class="values-title">Professionalism</h3>
					<p class="values-text">
						Our employees carry themselves professionally, convey a good attitude, and communicate with our clients and their coworkers in a professional manner.
					</p>
				</div>
				<div class="values-box">
					<div class="values-icon"><IconUsers /></div>
					<h3 class="values-title">People-centric</h3>
					<p class="values-text">
						We take client feedback into consideration when implementing changes or making decisions. Whether as a client or employee, we strive to ensure a secure and safe process from onboarding to offboarding.
					</p>
				</div>
			</div>
		</div>
	</section>
</Base>

<style>
	.story-section {
		padding: 30px;
		box-sizing: border-box;
	}
	.story-inner {
		max-width: 1140px;
		margin: 0 auto;
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 20px;
		box-sizing: border-box;
	}
	.story-col {
		flex: 0 0 560px;
		width: 560px;
		padding: 10px;
		box-sizing: border-box;
	}
	.story-para {
		font-family: Poppins, sans-serif;
		font-size: 16px;
		line-height: 24px;
		font-weight: 400;
		color: #2e2e2e;
		margin: 0 0 0.9em;
		text-align: left;
	}
	.story-para.drop-cap::first-letter {
		float: left;
		font-family: Poppins, sans-serif;
		font-size: 50px;
		line-height: 50px;
		font-weight: 400;
		color: #bf1e72;
		margin: 0 10px 0 0;
		width: 36px;
		height: 50px;
	}
	.story-photo {
		height: 586px;
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
	}
	.values-section {
		background: rgba(233, 27, 130, 0.07);
		padding: 0 50px;
		box-sizing: border-box;
	}
	.values-inner {
		max-width: 1140px;
		margin: 0 auto;
		padding-top: 50px;
		padding-bottom: 50px;
		box-sizing: border-box;
	}
	.values-heading {
		font-family: Nunito, sans-serif;
		font-size: 32px;
		line-height: 32px;
		font-weight: 600;
		color: #bf1e72;
		text-align: center;
		margin: 0 auto;
		width: fit-content;
	}
	/* Live: a 12px divider widget with the 2px line centred, 20px gaps around it. */
	.values-divider {
		width: 59px;
		height: 2px;
		background: #000000;
		margin: 25px auto;
	}
	/* Live's boxes are content-sized: 212 / 265 / 265 / 318 at 1440. As fractions of
	   the 1060px left after the gaps they reproduce those widths exactly. */
	.values-row {
		display: grid;
		grid-template-columns: 212fr 265fr 265fr 318fr;
		gap: 20px;
		padding: 10px;
		box-sizing: border-box;
	}
	.values-box {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}
	.values-icon {
		width: 60px;
		height: 60px;
		border: 2px solid #bf1e72;
		border-radius: 50%;
		padding: 14px;
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 0 auto;
		box-sizing: border-box;
	}
	.values-icon :global(svg) {
		width: 28px;
		height: 28px;
		fill: #bf1e72;
		display: block;
	}
	.values-title {
		font-family: Poppins, sans-serif;
		font-size: 22px;
		line-height: 26.4px;
		font-weight: 600;
		color: #252627;
		text-align: center;
		margin: 23px 0 16px;
	}
	.values-text {
		font-family: Poppins, sans-serif;
		font-size: 16px;
		line-height: 24px;
		font-weight: 400;
		color: #000000;
		text-align: center;
		margin: 0;
	}
	@media (max-width: 1024px) {
		.story-inner {
			flex-direction: column;
			align-items: stretch;
		}
		.story-col {
			flex: none;
			width: 100%;
		}
		.story-photo {
			height: 450px;
			min-height: 450px;
			background-position: 0 -129px;
		}
		.values-section {
			padding: 0 20px;
		}
		.values-row {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 767px) {
		/* Live keeps 30px at tablet; 20px all round only on mobile. */
		.story-section {
			padding: 20px;
		}
		.story-photo {
			background-position: center;
		}
		.values-row {
			grid-template-columns: 1fr;
			justify-items: center;
		}
		.values-box {
			width: 275px;
			max-width: 275px;
		}
	}
</style>
