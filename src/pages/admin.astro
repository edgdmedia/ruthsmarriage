---
/**
 * /admin/ — Ruth's team's door into the CMS. EmDash's admin lives at
 * /_emdash/admin and can't be moved, so this branded landing links there.
 * /login redirects here. noindex: it's for staff, not search.
 */
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Sign in | Ruth's Marriage</title>
		<meta name="robots" content="noindex, nofollow" />
		<style>
			:root {
				--plum: #5A0F36;
				--plum-700: #721646;
				--plum-800: #5A0F36;
				--plum-900: #3d0a24;
				--plum-950: #2a0718;
				--rose: #ED0D82;
				--rose-300: #f5a0ce;
				--text: #fff;
			}
			* { box-sizing: border-box; margin: 0; padding: 0; }
			body {
				min-height: 100vh;
				display: flex;
				font-family: "Nunito", system-ui, sans-serif;
				color: var(--text);
				background:
					radial-gradient(900px 400px at 90% -5%, rgba(189, 30, 114, 0.25), transparent 60%),
					linear-gradient(135deg, var(--plum-700) 0%, var(--plum-800) 50%, var(--plum-950) 100%);
			}
			.shell {
				width: 100%;
				max-width: 960px;
				margin: 0 auto;
				padding: 40px clamp(16px, 5vw, 48px) 32px;
				display: flex;
				flex-direction: column;
				gap: clamp(36px, 8vh, 64px);
			}
			.brand {
				display: flex;
				align-items: center;
				gap: 16px;
				flex-wrap: wrap;
			}
			.brand img {
				height: 52px;
				width: auto;
				border-radius: 8px;
			}
			.brand span {
				color: rgba(255, 255, 255, 0.55);
				font-size: 13px;
				font-weight: 600;
				letter-spacing: 0.1em;
				text-transform: uppercase;
			}
			main {
				flex: 1;
				display: flex;
				flex-direction: column;
				justify-content: center;
				gap: 20px;
			}
			.eyebrow {
				color: var(--rose-300);
				font-size: 12px;
				font-weight: 700;
				letter-spacing: 0.14em;
				text-transform: uppercase;
			}
			h1 {
				font-size: clamp(28px, 5vw, 48px);
				font-weight: 800;
				line-height: 1.12;
				max-width: 22ch;
				letter-spacing: -0.01em;
			}
			h1 em {
				font-style: normal;
				color: var(--rose-300);
			}
			.lede {
				max-width: 52ch;
				color: rgba(255, 255, 255, 0.82);
				font-size: clamp(14px, 1.6vw, 17px);
				line-height: 1.7;
			}
			.features {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
				gap: 14px;
				margin-top: 4px;
			}
			.feature {
				background: rgba(255, 255, 255, 0.07);
				border: 1px solid rgba(255, 255, 255, 0.14);
				border-radius: 12px;
				padding: 18px 20px;
				display: flex;
				flex-direction: column;
				gap: 6px;
			}
			.feature strong { font-size: 15px; font-weight: 700; }
			.feature span { color: rgba(255, 255, 255, 0.68); font-size: 13.5px; line-height: 1.5; }
			.actions {
				display: flex;
				gap: 12px;
				flex-wrap: wrap;
				margin-top: 12px;
			}
			.actions a {
				text-decoration: none;
				font-weight: 700;
				border-radius: 10px;
				padding: 13px 26px;
				transition: background 0.2s ease;
				font-size: 15px;
			}
			.primary {
				background: #fff;
				color: var(--plum-800);
			}
			.primary:hover { background: var(--rose-300); }
			.ghost {
				border: 1.5px solid rgba(255, 255, 255, 0.38);
				color: #fff;
			}
			.ghost:hover { background: rgba(255, 255, 255, 0.1); }
			.actions a:focus-visible {
				outline: 3px solid var(--rose-300);
				outline-offset: 3px;
			}
			.help {
				color: rgba(255, 255, 255, 0.55);
				font-size: 13.5px;
				line-height: 1.6;
			}
			footer {
				color: rgba(255, 255, 255, 0.4);
				font-size: 13px;
				text-align: center;
			}
		</style>
	</head>
	<body>
		<div class="shell">
			<header class="brand">
				<img src="/assets/media/2025/06/logo-2-1.png" alt="Ruth's Marriage" />
				<span>Content Manager</span>
			</header>

			<main>
				<p class="eyebrow">Marriage coaching, simplified</p>
				<h1>Manage your content <em>without the WordPress maze</em></h1>
				<p class="lede">
					Sign in to update services, publish resources, read Ask Coach questions, and manage
					the site's menus and settings.
				</p>

				<div class="features">
					<div class="feature">
						<strong>Services</strong>
						<span>Update pricing, formats, and descriptions for coaching packages.</span>
					</div>
					<div class="feature">
						<strong>Resources</strong>
						<span>Add new guides, books and videos to the library.</span>
					</div>
					<div class="feature">
						<strong>Ask Coach</strong>
						<span>Read and manage questions from website visitors.</span>
					</div>
				</div>

				<div class="actions">
					<a class="primary" href="/_emdash/admin">Sign in</a>
					<a class="ghost" href="/">Visit the public site</a>
				</div>
				<p class="help">
					Need access? Ask an admin to send you a sign-in link.
				</p>
			</main>

			<footer>Ruth's Marriage — Content Manager</footer>
		</div>
	</body>
</html>
