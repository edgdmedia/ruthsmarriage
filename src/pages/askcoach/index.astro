---
import Canvas from "../../layouts/Canvas.astro";
import { settings } from "../../data";
import { getSeoMeta } from "../../lib/seo";

const social = settings?.social || {};
const youtubeUrl = social.youtube || "#";
const instagramUrl = social.instagram || "#";

// TODO(G3): form submission wired to Resend + Turnstile once keys are provided
const formSubmitted = false;
const formError = false;

const seo = getSeoMeta({
    title: "Need Advice?",
    description: null,
    image: null,
    siteTitle: settings.title,
    siteUrl: "https://www.ruthsmarriage.com",
    path: "/askcoach",
});
---

<Canvas
    title={seo.title}
    pageTitle={seo.ogTitle}
    description={seo.description}
    image={seo.ogImage}
    canonical={seo.canonical}
>
    <section class="askcoach-section">
        <div class="askcoach-content">
            <h2 class="askcoach-title">Need Advice?</h2>
            <div class="askcoach-divider" />

            <p class="askcoach-intro">
                Send your questions below to get helpful answers from Coach Ruth
                in one of the YouTube episodes on Ask Coach Ruth! Your questions
                may also be shared with our Instagram channel community.
                <br /> Don't worry, it's strictly anonymous!
            </p>

            {/* TODO(G3): form submission wired to Resend + Turnstile once keys are provided */}
            <form class="askcoach-form">
                <label class="askcoach-label" for="category">
                    Category
                </label>
                <select id="category" name="category" class="askcoach-select">
                    <option value="love">Love</option>
                    <option value="dating">Dating</option>
                    <option value="marriage">Marriage</option>
                    <option value="sex">Sex</option>
                    <option value="faith">Faith</option>
                    <option value="life">Life</option>
                </select>

                <label class="askcoach-label" for="question">
                    Question
                </label>
                <textarea
                    id="question"
                    name="question"
                    rows="4"
                    placeholder="Question"
                    class="askcoach-textarea"
                ></textarea>

                {/* TODO(G3): Turnstile managed widget goes here once keys are provided */}
                <div class="askcoach-turnstile-placeholder">
                    <div class="turnstile-placeholder-box">
                        Turnstile widget (G3)
                    </div>
                </div>

                <button
                    type="submit"
                    class="askcoach-send"
                    disabled={formSubmitted || formError}
                >
                    Send
                </button>
            </form>

            {formSubmitted ? (
                <p class="askcoach-message success">
                    Your submission was successful.
                </p>
            ) : formError ? (
                <p class="askcoach-message error">
                    Your submission failed because of an error.
                </p>
            ) : null}

            <div class="askcoach-social">
                <a
                    href={youtubeUrl}
                    target="_blank"
                    rel="noopener"
                    class="askcoach-social-icon youtube"
                >
                    <svg
                        width="25"
                        height="25"
                        viewBox="0 0 24 24"
                        fill="#ffffff"
                        aria-hidden="true"
                    >
                        <path d="M23.498 6.386a3.32 3.32 0 0 0-2.137-2.137C19.555 3.173 19.033 3 12 3c-7.034 0-7.555 0.173-9.361 1.249A3.32 3.32 0 0 0 .502 7.614C0 8.39 0 9.61 0 12c0 2.39 0 3.61.502 4.386a3.32 3.32 0 0 0 2.137 2.137c1.806 1.076 2.327 1.249 9.361 1.249s7.555-0.173 9.361-1.249a3.32 3.32 0 0 0 2.137-2.137c0.502-0.776 0.502-1.996 0.502-4.386s0-2.61-0.502-4.386zm-9.429 12.759V6.414l5.33-3.076 5.33 3.076v6.731zm-2.665-5.826L12 8.04l-4.244-2.45v6.73z" />
                    </svg>
                </a>
                <a
                    href={instagramUrl}
                    target="_blank"
                    rel="noopener"
                    class="askcoach-social-icon instagram"
                >
                    <svg
                        width="25"
                        height="25"
                        viewBox="0 0 24 24"
                        fill="#ffffff"
                        aria-hidden="true"
                    >
                        <rect
                            width="20"
                            height="20"
                            x="2"
                            y="2"
                            rx="5"
                            ry="5"
                            fill="none"
                            stroke="#ffffff"
                            stroke-width="2"
                        ></rect>
                        <path d="M16.113 7.113a3.05 3.05 0 0 1 3.05 3.05v0a3.05 3.05 0 0 1-3.05 3.05v0a3.05 3.05 0 0 1-3.05-3.05v0a3.05 3.05 0 0 1 3.05-3.05"></path>
                        <path
                            d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z"
                            fill="none"
                            stroke="#ffffff"
                            stroke-width="2"
                        ></path>
                    </svg>
                </a>
            </div>
        </div>
    </section>
</Canvas>

<style>
    .askcoach-section {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 50px;
        background: #ffffff;
        box-sizing: border-box;
    }
    .askcoach-content {
        max-width: 627px;
        margin: 0 auto;
        width: 100%;
        box-sizing: border-box;
    }
    .askcoach-title {
        font-family: Nunito, sans-serif;
        font-size: 32px;
        line-height: 32px;
        font-weight: 700;
        color: #000000;
        text-align: center;
        margin: 0 0 20px;
    }
    .askcoach-divider {
        width: 86%;
        height: 1px;
        background: #000000;
        margin: 15px auto 15px;
    }
    .askcoach-intro {
        font-family: Nunito, sans-serif;
        font-size: 20px;
        line-height: 20px;
        font-weight: 500;
        color: #000000;
        text-align: center;
        margin: 0 0 40px;
    }
    .askcoach-form {
        display: flex;
        flex-direction: column;
        gap: 15px;
        margin-bottom: 40px;
    }
    .askcoach-label {
        font-family: Poppins, sans-serif;
        font-size: 16px;
        line-height: 16px;
        font-weight: 400;
        color: #2e2e2e;
        margin: 0;
        display: block;
    }
    .askcoach-select {
        width: 100%;
        height: 40px;
        font-family: Poppins, sans-serif;
        font-size: 16px;
        line-height: 1;
        color: #0e0e0e;
        background: #ffffff;
        border: 1px solid #69727d;
        border-radius: 7px;
        padding: 5px 20px 5px 14px;
        margin: 0;
        appearance: none;
        box-sizing: border-box;
    }
    .askcoach-textarea {
        width: 100%;
        height: 96px;
        font-family: Poppins, sans-serif;
        font-size: 15px;
        line-height: 21px;
        color: #0e0e0e;
        background: #ffffff;
        border: 1px solid #69727d;
        border-radius: 7px;
        padding: 5px 14px;
        margin: 0;
        box-sizing: border-box;
        resize: vertical;
    }
    .askcoach-turnstile-placeholder {
        display: flex;
        justify-content: center;
        margin-top: 8px;
    }
    .turnstile-placeholder-box {
        width: 100%;
        height: 60px;
        border: 1px dashed #cccccc;
        border-radius: 7px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #888888;
        font-size: 13px;
        font-family:
            system-ui,
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            Roboto,
            "Helvetica Neue",
            Arial,
            sans-serif;
    }
    .askcoach-send {
        width: 25%;
        max-width: 149px;
        height: 40px;
        font-family: Nunito, sans-serif;
        font-size: 15px;
        font-weight: 500;
        color: #ffffff;
        background: #252525;
        border-radius: 20px;
        border: none;
        padding: 0 24px;
        margin: 0;
        cursor: pointer;
        align-self: flex-start;
    }
    .askcoach-message {
        font-family: Poppins, sans-serif;
        font-size: 16px;
        line-height: 1;
        color: #2e2e2e;
        text-align: center;
        margin: 0;
    }
    .askcoach-social {
        display: flex;
        justify-content: center;
        gap: 5px;
        margin-top: 20px;
    }
    .askcoach-social-icon {
        width: 50px;
        height: 50px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
    }
    .askcoach-send:not(:disabled):hover {
        background: #252525;
        color: #ffffff;
    }
    .askcoach-send:disabled {
        cursor: not-allowed;
        opacity: 0.6;
    }
    @media (max-width: 767px) {
        .askcoach-send {
            width: 100%;
        }
    }
</style>
