---
import { actions, isInputError } from "astro:actions";
import { PUBLIC_TURNSTILE_SITE_KEY } from "astro:env/client";
import Canvas from "../../layouts/Canvas.astro";
import { CATEGORIES } from "../../actions";
import { settings } from "../../data";
import { IconInstagram } from "../../components/icons/instagram";
import { IconYoutube } from "../../components/icons/youtube";
import { getSeoMeta } from "../../lib/seo";

const social = settings?.social || {};
const youtubeUrl = social.youtube || "#";
const instagramUrl = social.instagram || "#";

// The askCoach action (src/actions) posts back to this page.
const result = Astro.getActionResult(actions.askCoach);
const formSubmitted = Boolean(result && !result.error);
const formError = !result?.error
    ? null
    : isInputError(result.error)
      ? (Object.values(result.error.fields).flat()[0] ?? "Please check the form.")
      : result.error.code === "TOO_MANY_REQUESTS"
        ? result.error.message
        : "Your submission failed because of an error.";

// Cloudflare's always-pass test key in dev; without a real key in production the
// form stays disabled (phase 6.4: no live form until the keys are set).
const siteKey = PUBLIC_TURNSTILE_SITE_KEY ?? (import.meta.env.DEV ? "1x00000000000000000000AA" : null);

const seo = getSeoMeta({
    title: "Need Advice?",
    description: null,
    image: null,
    siteTitle: settings.title,
    siteUrl: "https://www.ruthsmarriage.com",
    path: "/askcoach",
});
---

<Canvas
    title={seo.title}
    pageTitle={seo.ogTitle}
    description={seo.description}
    image={seo.ogImage}
    canonical={seo.canonical}
>
    <section class="askcoach-section">
        <div class="askcoach-content">
            <h2 class="askcoach-title">Need Advice?</h2>
            <div class="askcoach-divider" />

            <p class="askcoach-intro">
                Send your questions below to get helpful answers from Coach Ruth
                in one of the YouTube episodes on Ask Coach Ruth! Your questions
                may also be shared with our Instagram channel community.
                <br /> Don't worry, it's strictly anonymous!
            </p>

            <form class="askcoach-form" method="POST" action={actions.askCoach}>
                <label class="askcoach-label" for="category">
                    Category
                </label>
                <select id="category" name="category" class="askcoach-select">
                    {CATEGORIES.map((c) => <option value={c}>{c}</option>)}
                </select>

                <label class="askcoach-label" for="question">
                    Question
                </label>
                <textarea
                    id="question"
                    name="question"
                    rows="4"
                    placeholder="Question"
                    class="askcoach-textarea"
                    required
                ></textarea>

                {siteKey && <div class="cf-turnstile askcoach-turnstile" data-sitekey={siteKey} />}

                {/* Elementor replaces the button row with the result message on
                    success; on an error the message shows and Send stays for a retry. */}
                {formSubmitted ? (
                    <p class="askcoach-message success" role="status">
                        Your submission was successful.
                    </p>
                ) : (
                    <>
                        {formError && (
                            <p class="askcoach-message error" role="alert">{formError}</p>
                        )}
                        <button type="submit" class="askcoach-send" disabled={!siteKey}>Send</button>
                    </>
                )}
            </form>

            <div class="askcoach-social">
                <a
                    href={youtubeUrl}
                    target="_blank"
                    rel="noopener"
                    aria-label="YouTube"
                    class="askcoach-social-icon youtube"
                >
                    <IconYoutube />
                </a>
                <a
                    href={instagramUrl}
                    target="_blank"
                    rel="noopener"
                    aria-label="Instagram"
                    class="askcoach-social-icon instagram"
                >
                    <IconInstagram />
                </a>
            </div>
        </div>
    </section>
    {siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />}
</Canvas>

<style>
    .askcoach-section {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 50px;
        background: #ffffff;
        box-sizing: border-box;
    }
    .askcoach-content {
        max-width: 627px;
        margin: 0 auto;
        width: 100%;
        box-sizing: border-box;
    }
    .askcoach-title {
        font-family: Nunito, sans-serif;
        font-size: 32px;
        line-height: 32px;
        font-weight: 700;
        color: #000000;
        text-align: center;
        margin: 0 0 20px;
    }
    .askcoach-divider {
        width: 86%;
        height: 1px;
        background: #000000;
        /* 31px widget: 15px either side of the line, plus the 20px widget gap below. */
        margin: 15px auto 35px;
    }
    .askcoach-intro {
        font-family: Nunito, sans-serif;
        font-size: 20px;
        line-height: 20px;
        font-weight: 500;
        color: #000000;
        text-align: center;
        margin: 0 0 20px;
    }
    .askcoach-form {
        display: flex;
        flex-direction: column;
    }
    .askcoach-label {
        font-family: Poppins, sans-serif;
        font-size: 16px;
        line-height: 16px;
        font-weight: 400;
        color: #2e2e2e;
        margin: 0 0 12px;
        display: block;
    }
    .askcoach-select {
        width: 100%;
        height: 40px;
        font-family: Poppins, sans-serif;
        font-size: 16px;
        line-height: 1;
        color: #0e0e0e;
        border: 1px solid #69727d;
        border-radius: 7px;
        padding: 5px 20px 5px 14px;
        margin: 0 0 31px;
        appearance: none;
        /* Elementor's caret (the native arrow is hidden by appearance: none). */
        background: #ffffff url("data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 10 6%27%3E%3Cpath d=%27M0 0h10L5 6z%27 fill=%27%23000%27/%3E%3C/svg%3E") no-repeat right 14px center / 10px 6px;
        box-sizing: border-box;
    }
    .askcoach-textarea {
        width: 100%;
        height: 96px;
        font-family: Poppins, sans-serif;
        font-size: 15px;
        line-height: 21px;
        color: #0e0e0e;
        background: #ffffff;
        border: 1px solid #69727d;
        border-radius: 7px;
        padding: 5px 14px;
        margin: 0 0 31px;
        box-sizing: border-box;
        resize: vertical;
    }
    .askcoach-turnstile {
        min-height: 65px;
        margin: 0 0 31px;
    }
    .askcoach-send {
        width: 25%;
        max-width: 149px;
        height: 40px;
        font-family: Nunito, sans-serif;
        font-size: 15px;
        font-weight: 500;
        color: #ffffff;
        background: #252525;
        border-radius: 20px;
        border: none;
        padding: 0 24px;
        margin: 0;
        cursor: pointer;
        align-self: flex-start;
    }
    .askcoach-message.error + .askcoach-send {
        margin-top: 12px;
    }
    .askcoach-send:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
    .askcoach-message {
        font-family: Poppins, sans-serif;
        font-size: 16px;
        line-height: 24px;
        margin: 0;
    }
    /* Elementor .elementor-message-success / -danger colours. */
    .askcoach-message.success { color: #5cb85c; }
    .askcoach-message.error { color: #d9534f; }
    .askcoach-social {
        display: flex;
        justify-content: center;
        gap: 5px;
        margin-top: 20px;
    }
    .askcoach-social-icon {
        width: 50px;
        height: 50px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
    }
    .askcoach-social-icon :global(svg) { width: 25px; height: 25px; color: #ffffff; }
    .askcoach-social-icon.youtube { background: #CD201F; }
    .askcoach-social-icon.instagram { background: #262626; }
    .askcoach-send:hover {
        color: #ffffff;
    }
    @media (max-width: 767px) {
        .askcoach-send {
            width: 100%;
            max-width: none;
        }
    }
</style>
