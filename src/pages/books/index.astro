---
import Base from "../../layouts/Base.astro";
import { PageHero } from "../../components/PageHero";
import PortableText from "../../components/PortableText.astro";
import { resources, settings } from "../../data";
import { getSeoMeta } from "../../lib/seo";

const resourceList = [...resources]
	.filter((r) => r.status !== "draft")
	.filter((r) => r.terms?.resource_type?.some((t) => t.slug === "book"))
	.sort((a, b) => (a.order ?? 999) - (b.order ?? 999));

const seo = getSeoMeta({
	title: "Books",
	description: null,
	image: "/assets/media/2025/06/IMG_5071.png",
	siteTitle: settings.title,
	siteUrl: "https://www.ruthsmarriage.com",
	path: "/books",
});
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
>
	<PageHero variant="pattern" title="Books" image="/assets/media/2025/06/IMG_5071.png" />
	<section class="resource-list">
		{resourceList.map((resource, i) => {
			const isA = i % 2 === 0;
			return (
				<div class={`resource-row row-${isA ? "a" : "b"}`}>
					<div class="resource-row-inner">
						{isA ? (
							<>
								<div class="resource-row__image">
									{resource.featured_image && (
										<img
											src={resource.featured_image.src}
											alt={resource.featured_image.alt ?? ""}
											loading="lazy"
										/>
									)}
								</div>
								<div class="resource-row__text">
									<h2 class="resource-row__title">{resource.title}</h2>
									{resource.content ? (
										<div class="resource-row__description">
											<PortableText value={resource.content} />
										</div>
									) : null}
									<a
										href={`/resource/${resource.slug}/`}
										class="resource-row__btn"
									>
										{resource.badge_label || "Learn More"}
									</a>
								</div>
							</>
						) : (
							<>
								<div class="resource-row__text resource-row__text--pink">
									<h2 class="resource-row__title">{resource.title}</h2>
									{resource.content ? (
										<div class="resource-row__description">
											<PortableText value={resource.content} />
										</div>
									) : null}
									<a
										href={`/resource/${resource.slug}/`}
										class="resource-row__btn resource-row__btn--pink"
									>
										{resource.badge_label || "Learn More"}
									</a>
								</div>
								<div class="resource-row__image">
									{resource.featured_image && (
										<img
											src={resource.featured_image.src}
											alt={resource.featured_image.alt ?? ""}
											loading="lazy"
										/>
									)}
								</div>
							</>
						)}
					</div>
				</div>
			)
		})}
	</section>
</Base>

<style>
	.resource-list {
		padding: 0 10px;
		box-sizing: border-box;
	}
	.resource-row {
		display: flex;
		flex-direction: row;
		padding: 0 10px;
		box-sizing: border-box;
		flex-wrap: wrap;
	}
	.row-a {
		background: #ffffff;
	}
	.row-b {
		background: #BF1E7224;
	}
	.resource-row-inner {
		max-width: 1140px;
		margin: 0 auto;
		display: flex;
		width: 100%;
		box-sizing: border-box;
	}
	.resource-row__image {
		flex: 0 0 50%;
		padding: 20px;
		box-sizing: border-box;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.row-a .resource-row__image {
		padding: 20px 20px 50px;
	}
	.row-b .resource-row__image {
		padding: 20px 20px 50px;
		justify-content: flex-start;
	}
	.resource-row__image img {
		width: 100%;
		height: auto;
		object-fit: cover;
		display: block;
	}
	.resource-row__text {
		flex: 0 0 50%;
		padding: 50px 30px;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		justify-content: center;
		text-align: center;
		gap: 20px;
	}
	.row-b .resource-row__text {
		padding: 70px 30px;
	}
	.resource-row__title {
		font-family: Nunito, sans-serif;
		font-size: 32px;
		line-height: 32px;
		font-weight: 700;
		color: #000000;
		margin: 0;
	}
	.row-b .resource-row__title {
		color: #444547;
	}
	.resource-row__description {
		font-family: Poppins, sans-serif;
		font-size: 15px;
		line-height: 22.5px;
		font-weight: 400;
		color: #2E2E2E;
		margin: 0;
		text-align: center;
	}
	.row-b .resource-row__description {
		font-size: 16px;
		line-height: 24px;
	}
	.resource-row__btn {
		font-family: Nunito, sans-serif;
		font-size: 15px;
		font-weight: 600;
		color: #ffffff;
		background: #BF1E72;
		border-radius: 20px;
		padding: 12px 24px;
		border: none;
		cursor: pointer;
		text-align: center;
		text-decoration: none;
		display: inline-block;
	}
	.resource-row__btn--pink {
		background: #ED0D82;
	}
	@media (max-width: 1024px) {
		.resource-row__image {
			flex: 0 0 48%;
			padding: 20px 20px 50px;
		}
		.resource-row__text {
			flex: 0 0 52%;
			padding: 50px 30px;
		}
		.row-b .resource-row__text {
			padding: 70px 30px;
		}
	}
	@media (max-width: 767px) {
		.resource-row {
			flex-direction: column;
			padding: 0 20px;
		}
		.resource-row-inner {
			flex-direction: column;
		}
		.resource-row__image {
			flex: none;
			width: 100%;
			padding: 20px;
		}
		.row-a .resource-row__image {
			padding: 20px;
		}
		.row-b .resource-row__image {
			justify-content: center;
		}
		.resource-row__text {
			flex: none;
			width: 100%;
			padding: 20px;
			gap: 20px;
		}
		.row-b .resource-row__text {
			padding: 20px;
		}
	}
</style>
