---
import Base from "../../layouts/Base.astro";
import { PageHero } from "../../components/PageHero";
import { settings } from "../../data";
import { cancellationPolicyHtml } from "../../data/policies";
import { getSeoMeta } from "../../lib/seo";

const seo = getSeoMeta({
	title: "Cancellation Policy",
	description: settings.tagline || null,
	image: "/assets/media/2025/06/GetPaidStock.com-654a59f8c0055.jpg",
	siteTitle: settings.title,
	siteUrl: "https://www.ruthsmarriage.com",
	path: "/cancellation-policy",
});
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
>
	<PageHero variant="photo" title="Cancellation Policy" image="/assets/media/2025/06/GetPaidStock.com-654a59f8c0055.jpg" />

	<section class="policy-section">
		<div class="policy-inner">
			<Fragment set:html={cancellationPolicyHtml} />
		</div>
	</section>
</Base>

<style>
	.policy-section {
		padding: 50px;
		box-sizing: border-box;
	}
	@media (max-width: 767px) {
		.policy-section {
			padding: 30px 20px;
		}
	}
	.policy-inner {
		max-width: 1140px;
		margin: 0 auto;
	}
	.policy-inner :global(h4) {
		font-family: Poppins, sans-serif;
		font-size: 24px;
		line-height: 28.8px;
		font-weight: 500;
		color: #2e2e2e;
		margin: 8px 0 16px;
	}
	.policy-inner :global(h5) {
		font-family: Poppins, sans-serif;
		font-size: 20px;
		line-height: 24px;
		font-weight: 500;
		color: #2e2e2e;
		margin: 0 0 8px;
	}
	.policy-inner :global(p) {
		font-family: Poppins, sans-serif;
		font-size: 16px;
		line-height: 24px;
		font-weight: 400;
		color: #2e2e2e;
		margin: 0 0 0.9em;
	}
	.policy-inner :global(a) {
		color: #cc3366;
		text-decoration: underline;
	}
</style>
