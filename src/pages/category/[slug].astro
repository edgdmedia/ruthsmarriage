---
import Base from "../../layouts/Base.astro";
import { getTerm, postsInCategory } from "../../data";

const slug = Astro.params.slug ?? "";
const term = getTerm("category", slug);

if (!term) {
	return Astro.rewrite("/404");
}

const list = postsInCategory(term.slug);
---

<Base title={`${term.label} posts`} description={`Posts in ${term.label}`}>
	<h1>{term.label}</h1>

	{
		list.length === 0 ? (
			<p>No posts in this category yet.</p>
		) : (
			<ul>
				{list.map((post) => (
					<li>
						<a href={`/${post.slug}/`}>
							{post.featured_image && (
								<img
									src={post.featured_image.src}
									alt={post.featured_image.alt}
									width="300"
									height="200"
									loading="lazy"
								/>
							)}
							<h2>{post.title}</h2>
						</a>
						{post.excerpt && <p>{post.excerpt}</p>}
					</li>
				))}
			</ul>
		)
	}
</Base>
