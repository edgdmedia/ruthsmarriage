---
/* Category archive — same page and listing as search (owner request
   2026-10-24): ListingHero + ResultList, WordPress /page/N/ URLs. */
import Base from "../../../layouts/Base.astro";
import ListingHero from "../../../components/ListingHero.astro";
import ResultList from "../../../components/ResultList.astro";
import { getPosts, getTaxonomyTerm, published } from "../../../data";
import { postItem, pageNumber, paginate, pagedUrl } from "../../../lib/archive";

const posts = await getPosts();
const term = await getTaxonomyTerm("category", Astro.params.slug ?? "");
const page = pageNumber(Astro.params.page);
if (!term || page === null) return Astro.rewrite("/404");

const entries = published(posts).filter((e) => e.terms?.category?.some((t) => t.slug === term.slug));
const pageUrl = pagedUrl(`/category/${term.slug}/`);
const result = paginate(entries.map(postItem), page, pageUrl);
if (!result) return Astro.rewrite("/404");
---

<Base title={`Category: ${term.label}`}>
	<ListingHero eyebrow="Category" title={term.label} />
	<ResultList
		{...result}
		pageUrl={pageUrl}
		countLabel={`${entries.length} ${entries.length === 1 ? "article" : "articles"}`}
		empty={{ title: "Nothing here yet", text: "Browse one of these instead:" }}
	/>
</Base>
