---
import Base from "../../layouts/Base.astro";
import { PageHero } from "../../components/PageHero";
import { SocialIcons } from "../../components/SocialIcons";
import { IconEnvelope } from "../../components/icons/envelope";
import { settings } from "../../data";
import { getSeoMeta } from "../../lib/seo";

const heroImage = "/assets/media/2025/06/GetPaidStock.com-64f716fb8016a.jpg";
// Same fallback as the footer until settings carries contact_emails.
const emails: string[] = (settings as { contactEmails?: string[] }).contactEmails ?? [
	"admin@ruthsmarriage.com",
	"ruthsmarriage@gmail.com",
];

const seo = getSeoMeta({
	title: "Contact",
	description: settings.tagline || null,
	image: heroImage,
	siteTitle: settings.title,
	siteUrl: "https://www.ruthsmarriage.com",
	path: "/contact",
});
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
>
	<PageHero variant="photo" title="Contact" image={heroImage} />

	<!-- contact.md §2, live container 171f4a3 (post-52.css) -->
	<section class="contact-cards">
		<div class="contact-row">
			<div class="card email-card" style={`background-image: url("${heroImage}")`}>
				<div class="card-icon"><IconEnvelope /></div>
				<h2 class="card-heading">Email</h2>
				<p class="card-text">
					{
						emails.map((email, i) => (
							<>
								<a href={`mailto:${email}`}>{email}</a>
								{i < emails.length - 1 && ", "}
							</>
						))
					}
				</p>
			</div>

			<div class="card social-card">
				<h2 class="card-heading">Social Media</h2>
				<SocialIcons social={settings.social} />
			</div>
		</div>
	</section>
</Base>

<style>
	.contact-cards {
		padding: 70px 50px;
	}
	/* Two equal cards (560 @1440, 444.5 @1024); the row stretches both to the
	   taller one, and each centres its content. */
	.contact-row {
		max-width: 1140px;
		margin: 0 auto;
		display: flex;
		gap: 20px;
	}
	.card {
		flex: 1 1 0;
		min-width: 0;
		border-radius: 30px;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
	}
	.email-card {
		position: relative;
		overflow: hidden;
		padding: 40px;
		gap: 10px;
		background-size: cover;
		background-position: center;
	}
	.email-card::before {
		content: "";
		position: absolute;
		inset: 0;
		background: #000;
		opacity: 0.78;
	}
	.email-card > * {
		position: relative;
	}
	.social-card {
		padding: 30px;
		gap: 20px;
		background: #ffffff;
		border: 1px solid rgba(191, 30, 114, 0.05);
		box-shadow: 0 0 31px -10px rgba(49, 49, 49, 0.5);
	}
	/* far-envelope at 50px; live's icon wrapper is 56px tall (inline-block on a
	   24px line box). */
	.card-icon {
		height: 56px;
		font-size: 50px;
		line-height: 1;
		color: #bf1e72;
	}
	.card-icon :global(svg) {
		display: block;
	}
	.card-heading {
		font-family: "Nunito", sans-serif;
		font-size: 32px;
		line-height: 32px;
		font-weight: 600;
		color: #ffffff;
		margin: 0;
	}
	.social-card .card-heading {
		color: #222324;
	}
	.card-text {
		font-family: "Poppins", sans-serif;
		font-size: 16px;
		line-height: 24px;
		color: #7a7a7a;
		margin: 0;
	}
	.card-text a {
		color: #ffffff;
		text-decoration: none;
	}
	.social-card :global(.social-icons) {
		justify-content: center;
	}

	@media (max-width: 767px) {
		.contact-cards {
			padding: 50px 30px;
		}
		.contact-row {
			flex-direction: column;
		}
		.card {
			flex: none;
		}
		.social-card .card-heading {
			font-size: 23px;
			line-height: 23px;
		}
	}
</style>
