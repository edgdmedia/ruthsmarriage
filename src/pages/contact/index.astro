---
import Base from "../../layouts/Base.astro";
import { PageHero } from "../../components/PageHero";
import { settings } from "../../data";
import { getSeoMeta } from "../../lib/seo";

const social = settings?.social || {};
const youtubeUrl = social.youtube || "#";
const instagramUrl = social.instagram || "#";

const seo = getSeoMeta({
	title: "Contact",
	description: settings.tagline || null,
	image: "/assets/media/2025/06/GetPaidStock.com-64f716fb8016a.jpg",
	siteTitle: settings.title,
	siteUrl: "https://www.ruthsmarriage.com",
	path: "/contact",
});
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
>
	<PageHero
		variant="photo"
		title="Contact"
		image="/assets/media/2025/06/GetPaidStock.com-64f716fb8016a.jpg"
	/>

	<section class="contact-cards">
		<div class="contact-row">
			<!-- Email card -->
			<div class="card email-card">
				<div class="card-icon">
					<svg
						aria-hidden="true"
						viewBox="0 0 24 24"
						xmlns="http://www.w3.org/2000/svg"
						fill="currentColor"
					>
						<path d="M20 4H4c-1.1 0-1.9 0.9-1.9 2L2 18c0 1.1 0.9 2 2 2h16c1.1 0 2-0.9 2-2V6c0-1.1-0.9-2-2-2zm0 4L12 13l-8-5h8zm0-5L12 9l-8-5h8z" />
					</svg>
				</div>
				<h2 class="card-heading">Email</h2>
				<p class="card-text">
					<a href="mailto:admin@ruthsmarriage.com">admin@ruthsmarriage.com</a>,{" "}
					<a href="mailto:ruthsmarriage@gmail.com">ruthsmarriage@gmail.com</a>
				</p>
			</div>

			<!-- Social card -->
			<div class="card social-card">
				<h2 class="card-heading">Social Media</h2>
				<div class="social-icons">
					<a
						href={social.facebook || "#"}
						target="_blank"
						rel="noopener"
						class="social-icon"
						style="background:#3b5998"
					>
						<svg
							width="17"
							height="17"
							viewBox="0 0 24 24"
							fill="#ffffff"
							aria-hidden="true"
						>
							<path d="M22 12c0-5.52-4.48-10-10-10H2C.48 2 0 6.48 0 12c0 4.39 2.86 8.12 6.84 9.48v-6.18h-3.4v-3.32h3.4v-2.16c0-2.5 1.48-3.92 3.68-3.92 1.04 0 2.08.08 2.08.08v2.4h-1.52c-1.2 0-1.48.72-1.48 1.36v1.52h2.96l-.44 2.24h-2.52v6.18c3.98-1.36 6.84-5.08 6.84-9.48z" />
						</svg>
					</a>
					<a
						href={social.twitter || "#"}
						target="_blank"
						rel="noopener"
						class="social-icon"
						style="background:#1da1f2"
					>
						<svg
							width="17"
							height="17"
							viewBox="0 0 24 24"
							fill="#ffffff"
							aria-hidden="true"
						>
							<path d="M23.498 6.386a3.32 3.32 0 0 0-2.137-2.137C19.555 3.173 19.033 3 12 3c-7.034 0-7.555 0.173-9.361 1.249A3.32 3.32 0 0 0 .502 7.614C0 8.39 0 9.61 0 12c0 2.39 0 3.61.502 4.386a3.32 3.32 0 0 0 2.137 2.137c1.806 1.076 2.327 1.249 9.361 1.249s7.555-0.173 9.361-1.249a3.32 3.32 0 0 0 2.137-2.137c0.502-0.776 0.502-1.996 0.502-4.386s0-2.61-0.502-4.386zm-9.429 12.759V6.414l5.33-3.076 5.33 3.076v6.731zm-2.665-5.826L12 8.04l-4.244-2.45v6.73z" />
						</svg>
					</a>
					<a
						href={instagramUrl}
						target="_blank"
						rel="noopener"
						class="social-icon"
						style="background:#e1306c"
					>
						<svg
							width="17"
							height="17"
							viewBox="0 0 24 24"
							fill="#ffffff"
							aria-hidden="true"
						>
							<rect width="20" height="20" x="2" y="2" rx="5" ry="5" fill="none" stroke="#ffffff" stroke-width="2" />
							<path d="M16.113 7.113a3.05 3.05 0 0 1 3.05 3.05v0a3.05 3.05 0 0 1-3.05 3.05v0a3.05 3.05 0 0 1-3.05-3.05v0a3.05 3.05 0 0 1 3.05-3.05" />
							<path d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z" fill="none" stroke="#ffffff" stroke-width="2" />
						</svg>
					</a>
					{youtubeUrl ? (
						<a
							href={youtubeUrl}
							target="_blank"
							rel="noopener"
							class="social-icon"
							style="background:#cd201f"
						>
							<svg
								width="17"
								height="17"
								viewBox="0 0 24 24"
								fill="#ffffff"
								aria-hidden="true"
							>
								<path d="M23.498 6.386a3.32 3.32 0 0 0-2.137-2.137C19.555 3.173 19.033 3 12 3c-7.034 0-7.555 0.173-9.361 1.249A3.32 3.32 0 0 0 .502 7.614C0 8.39 0 9.61 0 12c0 2.39 0 3.61.502 4.386a3.32 3.32 0 0 0 2.137 2.137c1.806 1.076 2.327 1.249 9.361 1.249s7.555-0.173 9.361-1.249a3.32 3.32 0 0 0 2.137-2.137c0.502-0.776 0.502-1.996 0.502-4.386s0-2.61-0.502-4.386zm-9.429 12.759V6.414l5.33-3.076 5.33 3.076v6.731zm-2.665-5.826L12 8.04l-4.244-2.45v6.73z" />
							</svg>
						</a>
					) : null}
					<a
						href={social.threads || "#"}
						target="_blank"
						rel="noopener"
						class="social-icon"
						style="background:#000000"
					>
						<svg
							width="17"
							height="17"
							viewBox="0 0 24 24"
							fill="#ffffff"
							aria-hidden="true"
						>
							<path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12c0 3.832 2.17 7.136 5.222 8.784-.386.113-.778.234-1.166.377-.446.164-.834.397-1.18.672-.336.268-.656.565-.966.894-.312.33-.604.681-.862 1.062-.257.382-.484.788-.676 1.22-.193.435-.34.895-.448 1.375-.106.48-.166.966-.176 1.457-.012.49.012.976.082 1.457.07.481.176.957.318 1.423.142.466.316.925.53 1.368.212.44.466.858.75 1.246.284.39.604.754.944 1.094.34.34.702.644 1.082.926.38.282.776.535 1.182.756.446.243.914.444 1.396.598.536.17 1.082.294 1.64.368.556.074 1.112.096 1.664.096 1.394 0 2.776-.11 4.136-.33 1.36-.22 2.696-.562 3.984-1.014 1.29-.45 2.53-1.03 3.7-1.728 1.17-.7 2.286-1.514 3.33-2.432 1.044-.918 2.014-1.946 2.896-3.076.882-1.13 1.674-2.354 2.354-3.664.68-1.31 1.254-2.704 1.706-4.158.452-1.454.79-2.948 1.006-4.47.216-1.52.31-3.058.31-4.614 0-1.554-.094-3.094-.28-4.612-.186-1.518-.49-3.012-.904-4.474-.414-1.462-.944-2.896-1.58-4.292-.636-1.396-1.378-2.744-2.224-4.02-.846-1.276-1.79-2.464-2.824-3.552C20.154 2.562 19.08 2 17.968 2c-1.012 0-1.996.406-2.948 1.216-.952.81-1.816 1.752-2.584 2.806-.768 1.054-1.432 2.22-1.984 3.49-.552 1.27-1 2.63-1.334 4.06-.334 1.43-.55 2.896-.65 4.394-.1 1.498-.094 2.994.012 4.486.106 1.492.33 2.97.668 4.426.338 1.456.782 2.884 1.326 4.284.544 1.4 1.182 2.764 1.912 4.066.73 1.302 1.546 2.55 2.442 3.716.896 1.166 1.862 2.238 2.89 3.206 1.028.968 2.128 1.816 3.284 2.532 1.156.716 2.364 1.31 3.62 1.766 1.256.456 2.552.78 3.884.96 1.332.18 2.68.234 4.032.234 2.752 0 5.472-.632 8.09-1.884C22.48 16.523 22 14.316 22 12c0-5.523-4.477-10-10-10" />
						</svg>
					</a>
				</div>
			</div>
		</div>
	</section>
</Base>

<style>
	.contact-cards {
		padding: 0 50px;
		box-sizing: border-box;
	}
	.contact-row {
		max-width: 1140px;
		margin: 70px auto 70px;
		display: flex;
		gap: 20px;
		box-sizing: border-box;
	}
	.card {
		flex: 0 0 560px;
		width: 560px;
		height: 212px;
		border-radius: 30px;
		padding: 40px;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		gap: 10px;
	}
	.email-card {
		background-size: cover;
		background-position: center;
		background-image: url("/assets/media/2025/06/GetPaidStock.com-64f716fb8016a.jpg");
		position: relative;
		overflow: hidden;
	}
	.email-card::before {
		content: "";
		position: absolute;
		inset: 0;
		background: #000;
		opacity: 0.78;
		border-radius: 30px;
	}
	.email-card > * {
		position: relative;
		z-index: 1;
		color: #ffffff;
	}
	.social-card {
		background: #ffffff;
		border: 1px solid rgba(191, 30, 114, 0.05);
		box-shadow: 0 0 31px -10px rgba(49, 49, 49, 0.5);
	}
	.card-icon {
		width: 50px;
		height: 50px;
		border: 2px solid #bf1e72;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 0 auto;
	}
	.card-icon svg {
		width: 28px;
		height: 28px;
		fill: #bf1e72;
		display: block;
	}
	.card-heading {
		font-family: Nunito, sans-serif;
		font-size: 32px;
		line-height: 32px;
		font-weight: 600;
		color: #ffffff;
		margin: 0;
	}
	.social-card .card-heading {
		color: #222324;
	}
	.card-text {
		font-family: Poppins, sans-serif;
		font-size: 16px;
		line-height: 24px;
		font-weight: 400;
		color: #ffffff;
		margin: 0;
	}
	.social-card .card-text {
		color: #000000;
	}
	.card-text a {
		color: inherit;
		text-decoration: underline;
	}
	.social-icons {
		display: flex;
		gap: 20px;
		justify-content: center;
	}
	.social-icon {
		width: 34px;
		height: 34px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		text-decoration: none;
	}
	.social-icon svg {
		width: 17px;
		height: 17px;
		display: block;
	}
	@media (max-width: 1024px) {
		.contact-row {
			max-width: none;
			flex-wrap: wrap;
			justify-content: center;
		}
		.card {
			width: 445px;
			height: 236px;
		}
	}
	@media (max-width: 767px) {
		.contact-cards {
			padding: 0 30px;
		}
		.contact-row {
			flex-direction: column;
			gap: 20px;
			margin: 50px auto 50px;
		}
		.card {
			width: 315px;
			height: auto;
			min-height: 236px;
		}
	}
</style>
