---
import { getEmDashCollection, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import { HeroSlider } from "../components/HeroSlider";
import { SectionHeading } from "../components/SectionHeading";
import { WaveSection } from "../components/WaveSection";
import { Carousel } from "../components/Carousel";
import { ServiceCard } from "../components/ServiceCard";
import { TestimonialCard } from "../components/TestimonialCard";
import { ResourceCard } from "../components/ResourceCard";
import { PostCard } from "../components/PostCard";
import { Button } from "../components/Button";
import { setCacheHint } from "../lib/cache";

const settingsResult = await getSiteSettings();
setCacheHint(Astro.cache, settingsResult.cacheHint);
const settings = settingsResult.data;

const banners = await getEmDashCollection("marquee_items", {
	limit: 100,
	orderBy: { order: "asc" },
});
setCacheHint(Astro.cache, banners.cacheHint);

const services = await getEmDashCollection("services", {
	limit: 100,
	orderBy: { order: "asc" },
});
setCacheHint(Astro.cache, services.cacheHint);

const testimonials = await getEmDashCollection("testimonials", {
	limit: 100,
	orderBy: { order: "asc" },
});
setCacheHint(Astro.cache, testimonials.cacheHint);

const resources = await getEmDashCollection("resources", {
	limit: 100,
	orderBy: { order: "desc" },
});
setCacheHint(Astro.cache, resources.cacheHint);

const posts = await getEmDashCollection("posts", {
	limit: 6,
	orderBy: { published_at: "desc" },
});
setCacheHint(Astro.cache, posts.cacheHint);

const heroSlides = [
	{
		layout: "portrait",
		title: "Ruth’s Marriage",
		subtitle: "At Ruth’s Marriage, we believe you too can enjoy your marriage!",
		buttonLabel: "About Us",
		buttonUrl: "/about/",
		image: settings?.logo?.url || "/assets/logo.png",
	},
	{
		layout: "overlay",
		title: "Support and Counsel",
		subtitle: "We are here to provide you with the support and counsel that you need to transform your marriage positively.",
		buttonLabel: "Services",
		buttonUrl: "/services/",
		image: "/assets/placeholder.jpg",
	},
	{
		layout: "overlay",
		title: "Resources and Tools",
		subtitle: "We believe most marriage problems can be solved with the right resources and tools",
		buttonLabel: "Resources",
		buttonUrl: "/resources/",
		image: "/assets/placeholder.jpg",
	},
];
---
<Base title={settings?.title ?? "Ruth's Marriage"}>
	{/* 1. Hero slider */}
	<HeroSlider slides={heroSlides} />

	{/* 2. Intro statement */}
	<section style={{ padding: "0 50px", maxWidth: "1140px", margin: "0 auto", textAlign: "center" }}>
		<h2
			style={{
				fontFamily: "Poppins, sans-serif",
				fontSize: "24px",
				lineHeight: "24px",
				fontWeight: "500",
				color: "#363636",
				margin: "50px 0 30px 0",
			}}
		>
			Ruth’s Marriage is a marriage counseling and relationship coaching company focused on helping couples enjoy their marriage God’s way.
		</h2>
		<Button variant="pink" href="/about/">
			About Us
		</Button>
	</section>

	{/* 3. Counseling Services (wave) */}
	<WaveSection>
		<SectionHeading
			title="Counseling Services"
			subtitle="We provide counseling services for married couples and singles across different parts of the globe. Our services range from individual sessions to couples sessions and are held virtually."
		/>
		<Carousel
			slides={services.entries.map((s) => (
				<ServiceCard key={s.data.slug} service={s.data} />
			))}
			variant="content"
			autoplayMs={5000}
		/>
		<Button variant="pink" href="/services/" style={{ display: "block", width: "fit-content", margin: "20px auto 0 auto" }}>
			All Services
		</Button>
	</WaveSection>

	{/* 4. Testimonials */}
	<section style={{ padding: "0 50px", maxWidth: "1140px", margin: "0 auto" }}>
		<SectionHeading
			title="We believe you too can experience a positive transformation in your marriage. Hear what some of our clients are saying!!"
		/>
		<Carousel
			slides={testimonials.entries.map((t, i) => (
				<TestimonialCard key={i} testimonial={t.data} variant={i % 2 === 0 ? "dark" : "pink"} />
			))}
			variant="content"
			autoplayMs={5000}
		/>
	</section>

	{/* 5. Resources (wave) */}
	<WaveSection>
		<SectionHeading title="Resources" />
		<Carousel
			slides={resources.entries.map((r) => (
				<ResourceCard key={r.data.slug} resource={r.data} />
			))}
			variant="content"
			autoplayMs={5000}
		/>
		<Button variant="pink" href="/resources/" style={{ display: "block", width: "fit-content", margin: "20px auto 0 auto" }}>
			All Resources
		</Button>
	</WaveSection>

	{/* 6. Inspired Features */}
	<section style={{ padding: "0 50px", maxWidth: "1140px", margin: "0 auto" }}>
		<SectionHeading title="Inspired Features" />
		<Carousel
			slides={posts.entries.map((p) => (
				<PostCard key={p.data.slug} post={p.data} />
			))}
			variant="content"
			autoplayMs={5000}
		/>
	</section>
</Base>