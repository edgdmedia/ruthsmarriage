---
import Base from "../../layouts/Base.astro";
import { PageHero } from "../../components/PageHero";
import ListingRow from "../../components/ListingRow.astro";
import { getServices, settings } from "../../data";
import { getSeoMeta } from "../../lib/seo";

const services = await getServices();
const serviceList = services
	.filter((s) => s.terms?.service_type?.some((t) => t.slug === "married"))
	.sort((a, b) => (a.order ?? 999) - (b.order ?? 999));

const seo = getSeoMeta({
	title: "Married",
	description: null,
	image: "/assets/media/2025/06/8750075-1024x683-1.jpg",
	siteTitle: settings.title,
	siteUrl: "https://ruthsmarriage.com",
	path: "/married",
});
---

<Base title={seo.title} pageTitle={seo.ogTitle} image={seo.ogImage}>
	<PageHero variant="pattern-flat" title="Married" />
	<section class="service-list">
		{
			serviceList.map((service, i) => (
				<ListingRow
					kind="service"
					index={i}
					image={service.featured_image}
					title={service.title}
					audienceLabel={service.audience_label}
					format={service.format}
					content={service.content}
					href={`/service/${service.slug}/`}
					buttonLabel="Details & Pricing"
				/>
			))
		}
	</section>
</Base>

<style>
	.service-list {
		padding: 0;
	}
</style>
