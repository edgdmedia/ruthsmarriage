---
import Base from "../../layouts/Base.astro";
import PortableText from "../../components/PortableText.astro";
import { getPost, settings } from "../../data";
import { getSeoMeta } from "../../lib/seo";

const slug = Astro.params.slug ?? "";
const post = getPost(slug);

if (!post) {
	return Astro.rewrite("/404");
}

const seo = getSeoMeta({
	title: post.title,
	description: post.excerpt,
	image: post.featured_image?.src ?? null,
	siteTitle: settings.title,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

const tags = post.terms?.tag ?? [];
const categories = post.terms?.category ?? [];
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
>
	<article>
		{
			post.featured_image && (
				<img
					src={post.featured_image.src}
					alt={post.featured_image.alt}
					width="1200"
					height="630"
				/>
			)
		}

		<h1>{post.title}</h1>

		{
			post.publishedAt && (
				<time datetime={post.publishedAt}>
					{new Date(post.publishedAt).toLocaleDateString("en-US", {
						year: "numeric",
						month: "long",
						day: "numeric",
					})}
				</time>
			)
		}

		{
			categories.length > 0 && (
				<div>
					{categories.map((c) => (
						<a href={`/category/${c.slug}/`}>{c.label}</a>
					))}
				</div>
			)
		}

		<PortableText value={post.content} />

		{
			tags.length > 0 && (
				<div>
					{tags.map((t) => (
						<a href={`/tag/${t.slug}/`}>{t.label}</a>
					))}
				</div>
			)
		}
	</article>
</Base>
