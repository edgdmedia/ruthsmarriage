---
/* Resource Type archive (Hello default) — page-maps/default-pages.md "Archives". */
import Base from "../../../layouts/Base.astro";
import HelloMain from "../../../components/HelloMain.astro";
import ArchiveList from "../../../components/ArchiveList.astro";
import { getTerm, published, resources } from "../../../data";
import { resourceItem, pageNumber, paginate, pagedUrl } from "../../../lib/archive";

const term = getTerm("resource_type", Astro.params.slug ?? "");
const page = pageNumber(Astro.params.page);
if (!term || page === null) return Astro.rewrite("/404");

const entries = published(resources).filter((e) => e.terms?.resource_type?.some((t) => t.slug === term.slug));
const result = paginate(entries.map(resourceItem), page, pagedUrl(`/resource-type/${term.slug}/`));
if (!result) return Astro.rewrite("/404");
---

<Base title={`Resource Type: ${term.label}`}>
	<HelloMain title={`Resource Type: ${term.label}`}>
		<ArchiveList items={result.items} prevUrl={result.prevUrl} nextUrl={result.nextUrl} />
	</HelloMain>
</Base>
