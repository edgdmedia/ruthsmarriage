---
import Base from "../../layouts/Base.astro";
import { PageHero } from "../../components/PageHero";
import ListingRow from "../../components/ListingRow.astro";
import { getResources, settings } from "../../data";
import { getSeoMeta } from "../../lib/seo";

const resources = await getResources();
const resourceList = resources
	.filter((r) => r.terms?.resource_type?.some((t) => t.slug === "resource"))
	.sort((a, b) => (a.order ?? 999) - (b.order ?? 999));

const seo = getSeoMeta({
	title: "Courses, Guides & Intimacy Builders",
	description: null,
	image: "/assets/media/2025/06/WhatsApp-Image-2025-12-17-at-5.06.03-PM.jpeg",
	siteTitle: settings.title,
	siteUrl: "https://ruthsmarriage.com",
	path: "/resources",
});
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
>
	<PageHero
		variant="pattern-flat"
		title="Courses, Guides & Intimacy Builders"
		image="/assets/media/2025/06/WhatsApp-Image-2025-12-17-at-5.06.03-PM.jpeg"
	/>
	<section class="resource-list">
		{
			resourceList.map((resource, i) => (
				<ListingRow
					kind="resource"
					index={i}
					image={resource.featured_image}
					title={resource.title}
					content={resource.content}
					href={`/resource/${resource.slug}/`}
					buttonLabel={resource.badge_label || "Learn More"}
				/>
			))
		}
	</section>
</Base>

<style>
	.resource-list {
		padding: 0;
	}
</style>
