---
/* Search results — reached via /?s=term and /page/N/?s=term (WordPress URLs),
   see index.astro and page/[n].astro. `type` narrows to one content type.
   Owner-requested redesign (2026-10-24): ListingHero + type filters + ResultList,
   the same listing the archive pages use. */
import Base from "../../layouts/Base.astro";
import ListingHero from "../../components/ListingHero.astro";
import ResultList from "../../components/ResultList.astro";
import { getPosts, getResources, getServices, published } from "../../data";
import {
	type ArchiveItem,
	pageNumber,
	paginate,
	postItem,
	resourceItem,
	searchEntries,
	searchSource,
	serviceItem,
} from "../../lib/archive";

const [posts, resources, services] = await Promise.all([getPosts(), getResources(), getServices()]);
const query = (Astro.url.searchParams.get("s") ?? "").trim();
const type = Astro.url.searchParams.get("type");
const page = pageNumber(Astro.params.page);
if (page === null) return Astro.rewrite("/404");

const all = searchEntries(query, [
	...published(resources).map((r) => searchSource(r, resourceItem(r))),
	...published(services).map((s) => searchSource(s, serviceItem(s))),
	...published(posts).map((p) => searchSource(p, postItem(p))),
]);

const FILTERS: { kind: ArchiveItem["kind"] | null; label: string }[] = [
	{ kind: null, label: "All" },
	{ kind: "article", label: "Articles" },
	{ kind: "service", label: "Services" },
	{ kind: "resource", label: "Resources" },
];
const active = FILTERS.find((f) => f.kind === type) ?? FILTERS[0];
const results = active.kind ? all.filter((i) => i.kind === active.kind) : all;

const urlFor = (n: number, kind = active.kind) => {
	const params = new URLSearchParams({ s: query });
	if (kind) params.set("type", kind);
	return n === 1 ? `/?${params}` : `/page/${n}/?${params}`;
};
const result = paginate(results, page, (n) => urlFor(n));
if (!result) return Astro.rewrite("/404");
---

<Base title={query ? `Search results for “${query}”` : "Search"}>
	<ListingHero eyebrow="Search results" title={query ? `“${query}”` : "Search the site"} query={query} />
	<ResultList
		{...result}
		pageUrl={(n) => urlFor(n)}
		countLabel={`${results.length} ${results.length === 1 ? "result" : "results"}`}
		highlight={query}
		empty={{
			title: query ? `Nothing matches “${query}”` : "What are you looking for?",
			text: "Try a shorter or different word, or browse one of these:",
		}}
	>
		{all.length > 0 && (
			<nav slot="filters" class="search-filters" aria-label="Filter results">
				{FILTERS.map((f) => {
					const n = f.kind ? all.filter((i) => i.kind === f.kind).length : all.length;
					return (
						<a
							href={urlFor(1, f.kind)}
							class:list={["search-filter", { "is-active": f === active, "is-empty": n === 0 }]}
							aria-current={f === active ? "page" : undefined}
						>
							{f.label} <span>{n}</span>
						</a>
					);
				})}
			</nav>
		)}
	</ResultList>
</Base>

<style>
	.search-filters {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-bottom: 24px;
	}
	.search-filter {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 8px 16px;
		border: 1px solid #e4c3d4;
		border-radius: 20px;
		font-family: Poppins, sans-serif;
		font-size: 14px;
		color: #5a0f36;
		text-decoration: none;
	}
	.search-filter span {
		min-width: 22px;
		padding: 0 6px;
		border-radius: 11px;
		background: #bf1e7224;
		font-size: 12px;
		line-height: 20px;
		text-align: center;
		box-sizing: border-box;
	}
	.search-filter:hover {
		border-color: #bf1e72;
	}
	.search-filter.is-active {
		background: #5a0f36;
		border-color: #5a0f36;
		color: #ffffff;
	}
	.search-filter.is-active span {
		background: rgba(255, 255, 255, 0.2);
	}
	.search-filter.is-empty {
		opacity: 0.5;
	}
</style>
