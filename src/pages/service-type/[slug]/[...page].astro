---
/* Service type archive — same page and listing as search (owner request
   2026-10-24): ListingHero + ResultList, WordPress /page/N/ URLs. */
import Base from "../../../layouts/Base.astro";
import ListingHero from "../../../components/ListingHero.astro";
import ResultList from "../../../components/ResultList.astro";
import { getTerm, published, services } from "../../../data";
import { serviceItem, pageNumber, paginate, pagedUrl } from "../../../lib/archive";

const term = getTerm("service_type", Astro.params.slug ?? "");
const page = pageNumber(Astro.params.page);
if (!term || page === null) return Astro.rewrite("/404");

const entries = published(services).filter((e) => e.terms?.service_type?.some((t) => t.slug === term.slug));
const pageUrl = pagedUrl(`/service-type/${term.slug}/`);
const result = paginate(entries.map(serviceItem), page, pageUrl);
if (!result) return Astro.rewrite("/404");
---

<Base title={`Service type: ${term.label}`}>
	<ListingHero eyebrow="Service type" title={term.label} />
	<ResultList
		{...result}
		pageUrl={pageUrl}
		countLabel={`${entries.length} ${entries.length === 1 ? "service" : "services"}`}
		empty={{ title: "Nothing here yet", text: "Browse one of these instead:" }}
	/>
</Base>
