---
import Base from "../../layouts/Base.astro";
import DetailShell from "../../components/DetailShell.astro";
import { getService, settings } from "../../data";
import { BookingModal } from "../../components/BookingModal";
import { IconDotCircle } from "../../components/icons/dot-circle";
import PortableText from "../../components/PortableText.astro";

const slug = Astro.params.slug ?? "";
const service = getService(slug);

if (!service) {
	return Astro.rewrite("/404");
}

const serviceType = service.terms?.service_type?.[0];

const notice =
	service.notice ??
	settings.notice ??
	"After clicking “Book Service,” you’ll be guided to our policy page before proceeding to the payment section, where you can choose your preferred currency and complete your booking.";
---

<Base title={service.title} image={service.featured_image?.src ?? null}>
	<DetailShell variant="service" section="d355bcc">
		{service.featured_image && (
			<img
				slot="image"
				src={service.featured_image.src}
				alt={service.featured_image.alt || service.title}
				width="504"
				height="504"
			/>
		)}
		{serviceType && (
			<a href={`/service-type/${serviceType.slug}/`} class="service-pill">
				<IconDotCircle />
				{serviceType.label}
			</a>
		)}
		<h1 class="service-title">{service.title}</h1>
		{service.price_label && <h6 class="service-price">{service.price_label}</h6>}
		{service.audience_label && <p class="service-audience">{service.audience_label}</p>}
		{service.format && <p class="service-format">{service.format}</p>}
		<div class="service-description">
			<PortableText value={service.content} />
		</div>
		{notice && <p class="service-notice">{notice}</p>}
		<button type="button" class="service-book-btn" data-booking-open>Book Service</button>
	</DetailShell>

	<BookingModal bookingUrl={service.booking_url ?? ""} client:load />
	<script is:inline>
		// Queue a "Book Service" click made before the modal island hydrates.
		document.addEventListener("click", (event) => {
			const trigger = event.target.closest?.("[data-booking-open]");
			if (trigger && !window.__bookingReady) window.__bookingPending = trigger;
		});
	</script>
</Base>

<style>
	.service-pill {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		min-height: 26px;
		box-sizing: border-box;
		padding: 1px 5px 2px;
		background: #bf1e72;
		border-radius: 20px;
		font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
		font-size: 11px;
		line-height: 16.5px;
		color: #ffffff;
		text-decoration: none;
	}
	.service-pill :global(svg) {
		width: 11px;
		height: 11px;
	}
	.service-title {
		font-family: Nunito, sans-serif;
		font-size: 24px;
		line-height: 24px;
		font-weight: 700;
		color: #444547;
		margin: 0;
	}
	.service-price {
		font-family: Poppins, sans-serif;
		font-size: 16px;
		line-height: 16px;
		font-weight: 600;
		color: #bf1e72;
		margin: 0;
	}
	.service-audience {
		font-family: Poppins, sans-serif;
		font-size: 17px;
		line-height: 17px;
		font-style: italic;
		color: #000000;
		margin: -10px 0 0;
	}
	.service-format {
		font-family: Poppins, sans-serif;
		font-size: 16px;
		line-height: 16px;
		font-weight: 600;
		color: #000000;
		margin: 0;
	}
	.service-description {
		width: 100%;
		font-family: Poppins, sans-serif;
		font-size: 16px;
		line-height: 24px;
		color: #2e2e2e;
	}
	/* Elementor paragraphs keep a 14.4px bottom margin, the last one included. */
	.service-description :global(p) {
		margin: 0 0 14.4px;
	}
	.service-notice {
		font-family: Poppins, sans-serif;
		font-size: 13px;
		line-height: 19.5px;
		font-weight: 700;
		color: #2e2e2e;
		margin: 0 0 14.4px;
	}
	.service-book-btn {
		font-family: Nunito, sans-serif;
		font-size: 15px;
		line-height: 15px;
		font-weight: 600;
		color: #ffffff;
		background: #ed0d82;
		border: none;
		border-radius: 20px;
		padding: 12px 24px;
		cursor: pointer;
	}
</style>
