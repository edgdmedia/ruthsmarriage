---
import Base from "../../layouts/Base.astro";
import { getTerm, postsWithTag } from "../../data";

const slug = Astro.params.slug ?? "";
const term = getTerm("tag", slug);

if (!term) {
	return Astro.rewrite("/404");
}

const list = postsWithTag(term.slug);
---

<Base
	title={`Posts tagged "${term.label}"`}
	description={`Posts tagged ${term.label}`}
>
	<h1>Tag: {term.label}</h1>

	{
		list.length === 0 ? (
			<p>No posts with this tag yet.</p>
		) : (
			<ul>
				{list.map((post) => (
					<li>
						<a href={`/${post.slug}/`}>
							{post.featured_image && (
								<img
									src={post.featured_image.src}
									alt={post.featured_image.alt}
									width="300"
									height="200"
									loading="lazy"
								/>
							)}
							<h2>{post.title}</h2>
						</a>
						{post.excerpt && <p>{post.excerpt}</p>}
					</li>
				))}
			</ul>
		)
	}
</Base>
