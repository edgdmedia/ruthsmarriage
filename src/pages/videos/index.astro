---
import Base from "../../layouts/Base.astro";
import { PageHero } from "../../components/PageHero";
import YouTubeEmbed from "../../components/YouTubeEmbed.astro";
import { getResources, settings } from "../../data";
import { getSeoMeta } from "../../lib/seo";

const resources = await getResources();
const videoList = resources
	.filter((r) => r.terms?.resource_type?.some((t) => t.slug === "video"))
	.sort((a, b) => (a.order ?? 999) - (b.order ?? 999));

const seo = getSeoMeta({
	title: "Videos",
	description: null,
	siteTitle: settings.title,
	siteUrl: "https://ruthsmarriage.com",
	path: "/videos",
});
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
>
	<PageHero variant="pattern-flat" title="Videos" />
	<section class="video-list">
		{videoList.map((video) => (
			<div class="video-item">
				<YouTubeEmbed url={video.video_url} title={video.title} />
				<!-- Owner (2026-10-28): live shows bare embeds; the title (linked to
				     the detail page, like every other listing) is an approved addition. -->
				<h2 class="video-item__title">
					<a href={`/resource/${video.slug}/`}>{video.title}</a>
				</h2>
			</div>
		))}
	</section>
</Base>

<style>
	/* Two columns; one on phones, where half-width videos would be too small. */
	.video-list {
		padding: 50px;
		box-sizing: border-box;
		max-width: 1240px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 20px;
	}
	/* Owner (2026-10-28): titles under the embeds (live shows bare embeds —
	   approved deviation). Card-title style: Nunito 700 22px, centred. */
	.video-item__title {
		font-family: "Nunito", sans-serif;
		font-size: 22px;
		line-height: 22px;
		font-weight: 700;
		color: #000000;
		text-align: center;
		margin: 10px 0 0;
	}
	.video-item__title a {
		color: inherit;
		text-decoration: none;
	}
	@media (max-width: 767px) {
		.video-list {
			padding: 30px 20px;
			grid-template-columns: 1fr;
		}
	}
</style>
